  title   = {A Comment on: ``{M}onotone Comparative Statics''},
  journal = {Econometrica},
  year    = {2025},
  volume  = {93},
  number  = {4},
  pages   = {1481--1490},
  doi     = {10.3982/ECTA23292},
  note    = {Relaxes Milgrom--Shannon for discrete binary comparisons:
             quasisupermodularity is needed only of an auxiliary problem placed
             between the two objectives in the single-crossing-dominance order,
             not of either original objective. Definition 1 is the weak
             single-crossing dominance relation used here, Theorem 1(i)
             characterises strong-set ordering of the argmaxes by
             quasisupermodular dominance, and Theorem 1(ii) gives the
             completely-lower conclusion from the strict form. On a
             one-dimensional choice set the two dominance relations coincide,
             so Theorem 1(i) becomes a characterisation of the weak relation
             itself.}
}

