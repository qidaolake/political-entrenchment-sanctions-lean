  eprint    = {2506.04587},
  archivePrefix = {arXiv},
  primaryClass  = {math.OC},
  note      = {Introduces set smoothness, a three-point quadratic-order
               regularity condition on a solution correspondence, under which
               the optimistic and pessimistic hyper-objectives are weakly
               concave and weakly convex respectively. Example 3 is the
               boundary case relied on here: a smooth, uniformly strongly
               convex lower-level problem on a fixed box, with a unique
               monotone Lipschitz solution and a linear upper objective, whose
               reduced objective admits no weak-convexity modulus. The failure
               comes from the active constraint, not from any irregularity of
               the payoff, and the authors leave the constrained lower-level
               structural question open.}
