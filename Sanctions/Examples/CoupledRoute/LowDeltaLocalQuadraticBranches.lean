/-
Sanctions/Examples/CoupledRoute/LowDeltaLocalQuadraticBranches.lean

Exact branch algebra for the low-delta coupled problem when a box-smoothed
continuation is quadratic on the current state cell.

This is the local shape generated by a piecewise-linear value approximation:
on any cell where the two moving-window endpoints stay in fixed linear pieces,
the moving average is quadratic.  The results below therefore extend
`LowDeltaLocalBranches.lean` from affine to the cellwise-quadratic case needed
by a validated finite-mesh certificate.

Nothing in this file assumes that an equilibrium value is globally quadratic,
selects a branch, or postulates an equilibrium.  It proves only exact
identities and branchwise maximization facts from the already-defined
low-delta primitives.
-/

import Sanctions.Examples.CoupledRoute.LowDeltaLocalBranches

namespace Sanctions
namespace Examples

/-! ## Quadratic Sender continuation and its three response branches -/

/-- A quadratic continuation on one state cell. -/
noncomputable def lowDeltaQuadraticContinuation
    (c d e y : ℝ) : ℝ :=
  c + d * y + e * y ^ 2

/-- The Sender objective when its smeared continuation is quadratic on the
landing-state cell reached by `(x,s)`. -/
noncomputable def lowDeltaSenderQuadraticObjective
    (cS dS eS x a s : ℝ) : ℝ :=
  lowDeltaParams.U_S x a s
    + lowDeltaParams.β_S
      * lowDeltaQuadraticContinuation cS dS eS (lowDeltaParams.F x s)

/-- Effective Sender curvature after adding the quadratic continuation.
Positive values mean that the branch objective is strongly concave. -/
noncomputable def lowDeltaSenderQuadraticCurvature (eS : ℝ) : ℝ :=
  6 / 5 - eS / 10000

/-- Linear coefficient of the Sender branch objective. -/
noncomputable def lowDeltaSenderQuadraticLinear
    (dS eS x a : ℝ) : ℝ :=
  27 / 20 * x - 1 / 10 - a / 2 + dS / 200
    + 99 * eS * x / 10000

/-- Unconstrained Sender vertex on a quadratic continuation cell. -/
noncomputable def lowDeltaSenderQuadraticVertex
    (dS eS x a : ℝ) : ℝ :=
  lowDeltaSenderQuadraticLinear dS eS x a /
    lowDeltaSenderQuadraticCurvature eS

/-- The Target-action threshold at which the Sender vertex reaches one. -/
noncomputable def lowDeltaSenderQuadraticOneBoundary
    (dS eS x : ℝ) : ℝ :=
  2 * (lowDeltaSenderQuadraticLinear dS eS x 0
    - lowDeltaSenderQuadraticCurvature eS)

/-- The Target-action threshold at which the Sender vertex reaches zero. -/
noncomputable def lowDeltaSenderQuadraticZeroBoundary
    (dS eS x : ℝ) : ℝ :=
  2 * lowDeltaSenderQuadraticLinear dS eS x 0

/-- Difference of two Sender objective values in coefficient form. -/
theorem lowDelta_senderQuadraticObjective_sub
    (cS dS eS x a s t : ℝ) :
    lowDeltaSenderQuadraticObjective cS dS eS x a t
      - lowDeltaSenderQuadraticObjective cS dS eS x a s
      =
        lowDeltaSenderQuadraticLinear dS eS x a * (t - s)
          - (lowDeltaSenderQuadraticCurvature eS / 2) * (t ^ 2 - s ^ 2) := by
  simp only [lowDeltaSenderQuadraticObjective,
    lowDeltaQuadraticContinuation, lowDeltaSenderQuadraticLinear,
    lowDeltaSenderQuadraticCurvature, lowDeltaParams_U_S,
    lowDeltaParams_β_S, lowDeltaParams_F, mwU_S,
    Sanctions.AbstractGame.affineF]
  ring

/-- The unconstrained vertex satisfies the first-order coefficient identity. -/
theorem lowDelta_senderQuadraticCurvature_mul_vertex
    (dS eS x a : ℝ)
    (hκ : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaSenderQuadraticCurvature eS
        * lowDeltaSenderQuadraticVertex dS eS x a
      = lowDeltaSenderQuadraticLinear dS eS x a := by
  rw [lowDeltaSenderQuadraticVertex]
  exact mul_div_cancel₀ _ hκ

/-- Exact Sender complete-square identity on a quadratic continuation cell. -/
theorem lowDelta_senderQuadraticObjective_gap
    (cS dS eS x a s : ℝ)
    (hκ : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaSenderQuadraticObjective cS dS eS x a
        (lowDeltaSenderQuadraticVertex dS eS x a)
      - lowDeltaSenderQuadraticObjective cS dS eS x a s
      =
        (lowDeltaSenderQuadraticCurvature eS / 2)
          * (s - lowDeltaSenderQuadraticVertex dS eS x a) ^ 2 := by
  rw [lowDelta_senderQuadraticObjective_sub]
  rw [← lowDelta_senderQuadraticCurvature_mul_vertex dS eS x a hκ]
  ring

/-- Exact weak branch partition for the quadratic Sender vertex. -/
theorem lowDelta_senderQuadraticVertex_mem_Icc_iff
    (dS eS x a : ℝ) (hκ : 0 < lowDeltaSenderQuadraticCurvature eS) :
    lowDeltaSenderQuadraticVertex dS eS x a ∈ Set.Icc 0 1
      ↔ a ∈ Set.Icc
        (lowDeltaSenderQuadraticOneBoundary dS eS x)
        (lowDeltaSenderQuadraticZeroBoundary dS eS x) := by
  simp only [Set.mem_Icc, lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticOneBoundary,
    lowDeltaSenderQuadraticZeroBoundary]
  constructor
  · rintro ⟨h0, h1⟩
    have hL0 :
        0 * lowDeltaSenderQuadraticCurvature eS
          ≤ lowDeltaSenderQuadraticLinear dS eS x a :=
      (le_div_iff₀ hκ).mp h0
    have hLκ :
        lowDeltaSenderQuadraticLinear dS eS x a
          ≤ 1 * lowDeltaSenderQuadraticCurvature eS :=
      (div_le_iff₀ hκ).mp h1
    simp only [zero_mul, one_mul] at hL0 hLκ
    constructor <;>
      simp only [lowDeltaSenderQuadraticLinear] at hL0 hLκ ⊢ <;>
      linarith
  · rintro ⟨ha1, ha0⟩
    have hL0 : 0 ≤ lowDeltaSenderQuadraticLinear dS eS x a := by
      simp only [lowDeltaSenderQuadraticLinear] at ha0 ⊢
      linarith
    have hLκ :
        lowDeltaSenderQuadraticLinear dS eS x a
          ≤ lowDeltaSenderQuadraticCurvature eS := by
      simp only [lowDeltaSenderQuadraticLinear] at ha1 ⊢
      linarith
    constructor
    · exact (le_div_iff₀ hκ).mpr (by simpa using hL0)
    · exact (div_le_iff₀ hκ).mpr (by simpa using hLκ)

/-- Exact strict branch partition used to certify separation from the two
Sender kinks. -/
theorem lowDelta_senderQuadraticVertex_mem_Ioo_iff
    (dS eS x a : ℝ) (hκ : 0 < lowDeltaSenderQuadraticCurvature eS) :
    lowDeltaSenderQuadraticVertex dS eS x a ∈ Set.Ioo 0 1
      ↔ a ∈ Set.Ioo
        (lowDeltaSenderQuadraticOneBoundary dS eS x)
        (lowDeltaSenderQuadraticZeroBoundary dS eS x) := by
  simp only [Set.mem_Ioo, lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticOneBoundary,
    lowDeltaSenderQuadraticZeroBoundary]
  constructor
  · rintro ⟨h0, h1⟩
    have hL0 :
        0 * lowDeltaSenderQuadraticCurvature eS
          < lowDeltaSenderQuadraticLinear dS eS x a :=
      (lt_div_iff₀ hκ).mp h0
    have hLκ :
        lowDeltaSenderQuadraticLinear dS eS x a
          < 1 * lowDeltaSenderQuadraticCurvature eS :=
      (div_lt_iff₀ hκ).mp h1
    simp only [zero_mul, one_mul] at hL0 hLκ
    constructor <;>
      simp only [lowDeltaSenderQuadraticLinear] at hL0 hLκ ⊢ <;>
      linarith
  · rintro ⟨ha1, ha0⟩
    have hL0 : 0 < lowDeltaSenderQuadraticLinear dS eS x a := by
      simp only [lowDeltaSenderQuadraticLinear] at ha0 ⊢
      linarith
    have hLκ :
        lowDeltaSenderQuadraticLinear dS eS x a
          < lowDeltaSenderQuadraticCurvature eS := by
      simp only [lowDeltaSenderQuadraticLinear] at ha1 ⊢
      linarith
    constructor
    · exact (lt_div_iff₀ hκ).mpr (by simpa using hL0)
    · exact (div_lt_iff₀ hκ).mpr (by simpa using hLκ)

/-- On the interior branch, the unconstrained Sender vertex dominates every
feasible Sender action.  Feasibility is supplied separately by the branch
partition theorem. -/
theorem lowDelta_senderQuadraticVertex_isMaxOn
    (cS dS eS x a : ℝ)
    (hκ : 0 < lowDeltaSenderQuadraticCurvature eS) :
    IsMaxOn (lowDeltaSenderQuadraticObjective cS dS eS x a)
      (Set.Icc (0 : ℝ) 1) (lowDeltaSenderQuadraticVertex dS eS x a) := by
  intro s hs
  change lowDeltaSenderQuadraticObjective cS dS eS x a s
    ≤ lowDeltaSenderQuadraticObjective cS dS eS x a
      (lowDeltaSenderQuadraticVertex dS eS x a)
  have hgap := lowDelta_senderQuadraticObjective_gap
    cS dS eS x a s (ne_of_gt hκ)
  have hnonneg :
      0 ≤ (lowDeltaSenderQuadraticCurvature eS / 2)
        * (s - lowDeltaSenderQuadraticVertex dS eS x a) ^ 2 :=
    mul_nonneg (by linarith) (sq_nonneg _)
  linarith

/-- On the lower branch, zero is a Sender maximizer. -/
theorem lowDelta_senderQuadraticZero_isMaxOn
    (cS dS eS x a : ℝ)
    (hκ : 0 < lowDeltaSenderQuadraticCurvature eS)
    (hv : lowDeltaSenderQuadraticVertex dS eS x a ≤ 0) :
    IsMaxOn (lowDeltaSenderQuadraticObjective cS dS eS x a)
      (Set.Icc (0 : ℝ) 1) 0 := by
  intro s hs
  change lowDeltaSenderQuadraticObjective cS dS eS x a s
    ≤ lowDeltaSenderQuadraticObjective cS dS eS x a 0
  have hmul := lowDelta_senderQuadraticCurvature_mul_vertex
    dS eS x a (ne_of_gt hκ)
  have hs0 : 0 ≤ s := hs.1
  have hfac :
      0 ≤ s * (s / 2 - lowDeltaSenderQuadraticVertex dS eS x a) :=
    mul_nonneg hs0 (by linarith)
  have heq :
      lowDeltaSenderQuadraticObjective cS dS eS x a 0
          - lowDeltaSenderQuadraticObjective cS dS eS x a s
        =
          lowDeltaSenderQuadraticCurvature eS
            * (s * (s / 2 - lowDeltaSenderQuadraticVertex dS eS x a)) := by
    rw [lowDelta_senderQuadraticObjective_sub, ← hmul]
    ring
  have hprod :=
    mul_nonneg (le_of_lt hκ) hfac
  linarith

/-- On the upper branch, one is a Sender maximizer. -/
theorem lowDelta_senderQuadraticOne_isMaxOn
    (cS dS eS x a : ℝ)
    (hκ : 0 < lowDeltaSenderQuadraticCurvature eS)
    (hv : 1 ≤ lowDeltaSenderQuadraticVertex dS eS x a) :
    IsMaxOn (lowDeltaSenderQuadraticObjective cS dS eS x a)
      (Set.Icc (0 : ℝ) 1) 1 := by
  intro s hs
  change lowDeltaSenderQuadraticObjective cS dS eS x a s
    ≤ lowDeltaSenderQuadraticObjective cS dS eS x a 1
  have hmul := lowDelta_senderQuadraticCurvature_mul_vertex
    dS eS x a (ne_of_gt hκ)
  have hs1 : s ≤ 1 := hs.2
  have hfac :
      0 ≤ (1 - s)
        * (lowDeltaSenderQuadraticVertex dS eS x a - (1 + s) / 2) :=
    mul_nonneg (by linarith) (by linarith)
  have heq :
      lowDeltaSenderQuadraticObjective cS dS eS x a 1
          - lowDeltaSenderQuadraticObjective cS dS eS x a s
        =
          lowDeltaSenderQuadraticCurvature eS
            * ((1 - s)
              * (lowDeltaSenderQuadraticVertex dS eS x a - (1 + s) / 2)) := by
    rw [lowDelta_senderQuadraticObjective_sub, ← hmul]
    ring
  have hprod :=
    mul_nonneg (le_of_lt hκ) hfac
  linarith

/-! ## Target objective on the realized interior Sender branch -/

/-- Sender vertex at Target action zero. -/
noncomputable def lowDeltaSenderQuadraticIntercept
    (dS eS x : ℝ) : ℝ :=
  lowDeltaSenderQuadraticVertex dS eS x 0

/-- Absolute slope of the interior Sender response with respect to the Target
action. -/
noncomputable def lowDeltaSenderQuadraticActionSlope (eS : ℝ) : ℝ :=
  1 / (2 * lowDeltaSenderQuadraticCurvature eS)

/-- Affine representation of the interior Sender response. -/
noncomputable def lowDeltaSenderQuadraticInteriorResponse
    (dS eS x a : ℝ) : ℝ :=
  lowDeltaSenderQuadraticIntercept dS eS x
    - lowDeltaSenderQuadraticActionSlope eS * a

/-- The vertex formula equals its affine-in-action representation whenever
the Sender curvature is nonzero. -/
theorem lowDelta_senderQuadraticVertex_eq_interiorResponse
    (dS eS x a : ℝ)
    (hκ : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaSenderQuadraticVertex dS eS x a
      = lowDeltaSenderQuadraticInteriorResponse dS eS x a := by
  simp only [lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticInteriorResponse,
    lowDeltaSenderQuadraticIntercept,
    lowDeltaSenderQuadraticActionSlope,
    lowDeltaSenderQuadraticLinear]
  field_simp [hκ]
  ring

/-- Landing state at Target action zero on the interior Sender branch. -/
noncomputable def lowDeltaTargetQuadraticLandingIntercept
    (dS eS x : ℝ) : ℝ :=
  99 / 100 * x + lowDeltaSenderQuadraticIntercept dS eS x / 100

/-- Absolute slope of the landing state with respect to the Target action. -/
noncomputable def lowDeltaTargetQuadraticLandingSlope (eS : ℝ) : ℝ :=
  lowDeltaSenderQuadraticActionSlope eS / 100

/-- Effective Target curvature after substituting the realized interior
Sender response and the quadratic Target continuation. -/
noncomputable def lowDeltaTargetQuadraticCurvature (eS eT : ℝ) : ℝ :=
  2 + lowDeltaSenderQuadraticActionSlope eS
    - (9 / 5) * eT * lowDeltaTargetQuadraticLandingSlope eS ^ 2

/-- Linear coefficient of the Target objective after substituting the realized
interior Sender response. -/
noncomputable def lowDeltaTargetQuadraticLinear
    (dS eS dT eT x : ℝ) : ℝ :=
  2 * x - 1
    + lowDeltaSenderQuadraticActionSlope eS * (1 / 2 - x)
    + lowDeltaSenderQuadraticIntercept dS eS x / 2
    - (9 / 10) * lowDeltaTargetQuadraticLandingSlope eS
      * (dT + 2 * eT * lowDeltaTargetQuadraticLandingIntercept dS eS x)

/-- Target objective on the realized interior Sender branch. -/
noncomputable def lowDeltaTargetQuadraticInteriorObjective
    (cT dS eS dT eT x a : ℝ) : ℝ :=
  let s := lowDeltaSenderQuadraticInteriorResponse dS eS x a
  lowDeltaParams.U_T x a s
    + lowDeltaParams.β_T
      * lowDeltaQuadraticContinuation cT dT eT (lowDeltaParams.F x s)

/-- Difference of two Target objective values on the interior branch. -/
theorem lowDelta_targetQuadraticInteriorObjective_sub
    (cT dS eS dT eT x a b : ℝ) :
    lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x b
      - lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x a
      =
        lowDeltaTargetQuadraticLinear dS eS dT eT x * (b - a)
          - (lowDeltaTargetQuadraticCurvature eS eT / 2)
            * (b ^ 2 - a ^ 2) := by
  simp only [lowDeltaTargetQuadraticInteriorObjective,
    lowDeltaSenderQuadraticInteriorResponse,
    lowDeltaQuadraticContinuation, lowDeltaTargetQuadraticLinear,
    lowDeltaTargetQuadraticCurvature,
    lowDeltaTargetQuadraticLandingSlope,
    lowDeltaTargetQuadraticLandingIntercept,
    lowDeltaParams_U_T, lowDeltaParams_β_T, lowDeltaParams_F,
    mwU_T, Sanctions.AbstractGame.affineF]
  ring

/-- Unconstrained Target vertex on the realized interior Sender branch. -/
noncomputable def lowDeltaTargetQuadraticInteriorVertex
    (dS eS dT eT x : ℝ) : ℝ :=
  lowDeltaTargetQuadraticLinear dS eS dT eT x /
    lowDeltaTargetQuadraticCurvature eS eT

/-- The Target interior vertex satisfies its coefficient identity. -/
theorem lowDelta_targetQuadraticCurvature_mul_vertex
    (dS eS dT eT x : ℝ)
    (hκ : lowDeltaTargetQuadraticCurvature eS eT ≠ 0) :
    lowDeltaTargetQuadraticCurvature eS eT
        * lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x
      = lowDeltaTargetQuadraticLinear dS eS dT eT x := by
  rw [lowDeltaTargetQuadraticInteriorVertex]
  exact mul_div_cancel₀ _ hκ

/-- Exact Target complete-square identity on the realized interior branch. -/
theorem lowDelta_targetQuadraticInteriorObjective_gap
    (cT dS eS dT eT x a : ℝ)
    (hκ : lowDeltaTargetQuadraticCurvature eS eT ≠ 0) :
    lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x
        (lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x)
      - lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x a
      =
        (lowDeltaTargetQuadraticCurvature eS eT / 2)
          * (a - lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x) ^ 2 := by
  rw [lowDelta_targetQuadraticInteriorObjective_sub]
  rw [← lowDelta_targetQuadraticCurvature_mul_vertex dS eS dT eT x hκ]
  ring

/-- With positive induced curvature, the interior Target vertex dominates
every Target action; branch membership is checked separately. -/
theorem lowDelta_targetQuadraticInteriorVertex_isMaxOn
    (cT dS eS dT eT x : ℝ)
    (hκ : 0 < lowDeltaTargetQuadraticCurvature eS eT) :
    IsMaxOn
      (lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x)
      (Set.Icc (0 : ℝ) 1)
      (lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x) := by
  intro a ha
  change lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x a
    ≤ lowDeltaTargetQuadraticInteriorObjective cT dS eS dT eT x
      (lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x)
  have hgap := lowDelta_targetQuadraticInteriorObjective_gap
    cT dS eS dT eT x a (ne_of_gt hκ)
  have hnonneg :
      0 ≤ (lowDeltaTargetQuadraticCurvature eS eT / 2)
        * (a - lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x) ^ 2 :=
    mul_nonneg (by linarith) (sq_nonneg _)
  linarith

/-! ## Cellwise free boundary of the Target interior vertex -/

/-- State slope of the Target objective's linear coefficient on a fixed
quadratic-continuation cell. -/
noncomputable def lowDeltaTargetQuadraticLinearStateSlope
    (dS eS dT eT : ℝ) : ℝ :=
  lowDeltaTargetQuadraticLinear dS eS dT eT 1
    - lowDeltaTargetQuadraticLinear dS eS dT eT 0

/-- State slope of the unconstrained Target interior vertex. -/
noncomputable def lowDeltaTargetQuadraticInteriorVertexStateSlope
    (dS eS dT eT : ℝ) : ℝ :=
  lowDeltaTargetQuadraticLinearStateSlope dS eS dT eT /
    lowDeltaTargetQuadraticCurvature eS eT

/-- On a fixed quadratic-continuation cell, the Target objective's linear
coefficient is exactly affine in the state. -/
theorem lowDelta_targetQuadraticLinear_eq_at_zero_add_slope_mul
    (dS eS dT eT x : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaTargetQuadraticLinear dS eS dT eT x
      =
        lowDeltaTargetQuadraticLinear dS eS dT eT 0
          + lowDeltaTargetQuadraticLinearStateSlope dS eS dT eT * x := by
  simp only [lowDeltaTargetQuadraticLinear,
    lowDeltaTargetQuadraticLinearStateSlope,
    lowDeltaSenderQuadraticActionSlope,
    lowDeltaSenderQuadraticIntercept,
    lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticLinear,
    lowDeltaTargetQuadraticLandingSlope,
    lowDeltaTargetQuadraticLandingIntercept]
  field_simp [hκS]
  ring

/-- Consequently, the unconstrained Target interior vertex is affine in the
state on each fixed continuation cell. -/
theorem lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
    (dS eS dT eT x : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x
      =
        lowDeltaTargetQuadraticInteriorVertex dS eS dT eT 0
          + lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT * x := by
  rw [lowDeltaTargetQuadraticInteriorVertex,
    lowDeltaTargetQuadraticInteriorVertex,
    lowDelta_targetQuadraticLinear_eq_at_zero_add_slope_mul
      dS eS dT eT x hκS]
  simp only [lowDeltaTargetQuadraticInteriorVertexStateSlope]
  ring

/-- Difference form of the cellwise affine Target vertex. -/
theorem lowDelta_targetQuadraticInteriorVertex_sub
    (dS eS dT eT x y : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0) :
    lowDeltaTargetQuadraticInteriorVertex dS eS dT eT y
        - lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x
      =
        lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT
          * (y - x) := by
  rw [lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
      dS eS dT eT y hκS,
    lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
      dS eS dT eT x hκS]
  ring

/-- With positive cell slope, the Target interior vertex is strictly
increasing in the state. -/
theorem lowDelta_targetQuadraticInteriorVertex_strictMono
    (dS eS dT eT : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0)
    (hslope :
      0 < lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT) :
    StrictMono
      (lowDeltaTargetQuadraticInteriorVertex dS eS dT eT) := by
  intro x y hxy
  have hsub := lowDelta_targetQuadraticInteriorVertex_sub
    dS eS dT eT x y hκS
  have hprod :
      0 <
        lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT
          * (y - x) :=
    mul_pos hslope (sub_pos.mpr hxy)
  linarith

/-- The state at which the cellwise Target interior vertex crosses zero. -/
noncomputable def lowDeltaTargetQuadraticSwitchState
    (dS eS dT eT : ℝ) : ℝ :=
  -lowDeltaTargetQuadraticInteriorVertex dS eS dT eT 0 /
    lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT

/-- A nonzero cell slope makes the displayed switch state an exact zero of
the Target interior vertex. -/
theorem lowDelta_targetQuadraticInteriorVertex_at_switch
    (dS eS dT eT : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0)
    (hslope :
      lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT ≠ 0) :
    lowDeltaTargetQuadraticInteriorVertex dS eS dT eT
        (lowDeltaTargetQuadraticSwitchState dS eS dT eT)
      = 0 := by
  rw [lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
    dS eS dT eT _ hκS]
  simp only [lowDeltaTargetQuadraticSwitchState]
  field_simp
  ring

/-- Below a positive-slope cellwise switch, the unconstrained Target vertex is
negative; above it, the vertex is positive.  This is the exact transversal
free-boundary alternative to a uniformly strict branch gap. -/
theorem lowDelta_targetQuadraticInteriorVertex_lt_zero_iff
    (dS eS dT eT x : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0)
    (hslope :
      0 < lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT) :
    lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x < 0
      ↔ x < lowDeltaTargetQuadraticSwitchState dS eS dT eT := by
  rw [lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
    dS eS dT eT x hκS]
  simp only [lowDeltaTargetQuadraticSwitchState]
  constructor
  · intro h
    apply (lt_div_iff₀ hslope).mpr
    nlinarith
  · intro h
    have hh := (lt_div_iff₀ hslope).mp h
    nlinarith

/-- Weak-sign version of the switch characterization. -/
theorem lowDelta_targetQuadraticInteriorVertex_le_zero_iff
    (dS eS dT eT x : ℝ)
    (hκS : lowDeltaSenderQuadraticCurvature eS ≠ 0)
    (hslope :
      0 < lowDeltaTargetQuadraticInteriorVertexStateSlope dS eS dT eT) :
    lowDeltaTargetQuadraticInteriorVertex dS eS dT eT x ≤ 0
      ↔ x ≤ lowDeltaTargetQuadraticSwitchState dS eS dT eT := by
  rw [lowDelta_targetQuadraticInteriorVertex_eq_at_zero_add_slope_mul
    dS eS dT eT x hκS]
  simp only [lowDeltaTargetQuadraticSwitchState]
  constructor
  · intro h
    apply (le_div_iff₀ hslope).mpr
    nlinarith
  · intro h
    have hh := (le_div_iff₀ hslope).mp h
    nlinarith

/-! ## Target objectives on the two Sender boundary branches -/

/-- Target objective when the realized Sender action is zero. -/
noncomputable def lowDeltaTargetQuadraticZeroObjective
    (cT dT eT x a : ℝ) : ℝ :=
  lowDeltaParams.U_T x a 0
    + lowDeltaParams.β_T
      * lowDeltaQuadraticContinuation cT dT eT (lowDeltaParams.F x 0)

/-- Unconstrained Target vertex on the Sender-zero branch. -/
noncomputable def lowDeltaTargetQuadraticZeroVertex (x : ℝ) : ℝ :=
  x - 1 / 2

/-- Exact Target gap on the Sender-zero branch. -/
theorem lowDelta_targetQuadraticZeroObjective_gap
    (cT dT eT x a : ℝ) :
    lowDeltaTargetQuadraticZeroObjective cT dT eT x
        (lowDeltaTargetQuadraticZeroVertex x)
      - lowDeltaTargetQuadraticZeroObjective cT dT eT x a
      = (a - lowDeltaTargetQuadraticZeroVertex x) ^ 2 := by
  simp only [lowDeltaTargetQuadraticZeroObjective,
    lowDeltaTargetQuadraticZeroVertex, lowDeltaQuadraticContinuation,
    lowDeltaParams_U_T, lowDeltaParams_β_T, lowDeltaParams_F,
    mwU_T, Sanctions.AbstractGame.affineF]
  ring

/-- Target objective when the realized Sender action is one. -/
noncomputable def lowDeltaTargetQuadraticOneObjective
    (cT dT eT x a : ℝ) : ℝ :=
  lowDeltaParams.U_T x a 1
    + lowDeltaParams.β_T
      * lowDeltaQuadraticContinuation cT dT eT (lowDeltaParams.F x 1)

/-- Unconstrained Target vertex on the Sender-one branch. -/
noncomputable def lowDeltaTargetQuadraticOneVertex (x : ℝ) : ℝ :=
  x - 1 / 4

/-- Exact Target gap on the Sender-one branch. -/
theorem lowDelta_targetQuadraticOneObjective_gap
    (cT dT eT x a : ℝ) :
    lowDeltaTargetQuadraticOneObjective cT dT eT x
        (lowDeltaTargetQuadraticOneVertex x)
      - lowDeltaTargetQuadraticOneObjective cT dT eT x a
      = (a - lowDeltaTargetQuadraticOneVertex x) ^ 2 := by
  simp only [lowDeltaTargetQuadraticOneObjective,
    lowDeltaTargetQuadraticOneVertex, lowDeltaQuadraticContinuation,
    lowDeltaParams_U_T, lowDeltaParams_β_T, lowDeltaParams_F,
    mwU_T, Sanctions.AbstractGame.affineF]
  ring

/-! ## Affine-cell compatibility -/

/-- The quadratic Sender curvature reduces to the affine modulus at `eS=0`. -/
@[simp] theorem lowDeltaSenderQuadraticCurvature_zero :
    lowDeltaSenderQuadraticCurvature 0 = 6 / 5 := by
  simp [lowDeltaSenderQuadraticCurvature]

/-- The quadratic Sender vertex reduces exactly to the earlier affine vertex. -/
@[simp] theorem lowDeltaSenderQuadraticVertex_zero
    (dS x a : ℝ) :
    lowDeltaSenderQuadraticVertex dS 0 x a
      = lowDeltaSenderInteriorVertex dS x a := by
  simp only [lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticLinear, lowDeltaSenderQuadraticCurvature,
    lowDeltaSenderInteriorVertex]
  ring

/-- With both quadratic coefficients zero, the induced Target curvature is the
earlier affine value `29/12`. -/
@[simp] theorem lowDeltaTargetQuadraticCurvature_zero :
    lowDeltaTargetQuadraticCurvature 0 0 = 29 / 12 := by
  norm_num [lowDeltaTargetQuadraticCurvature,
    lowDeltaSenderQuadraticActionSlope,
    lowDeltaSenderQuadraticCurvature,
    lowDeltaTargetQuadraticLandingSlope]

/-- The quadratic Target vertex reduces exactly to the earlier affine vertex. -/
@[simp] theorem lowDeltaTargetQuadraticInteriorVertex_zero
    (dS dT x : ℝ) :
    lowDeltaTargetQuadraticInteriorVertex dS 0 dT 0 x
      = lowDeltaTargetInteriorVertex dS dT x := by
  simp only [lowDeltaTargetQuadraticInteriorVertex,
    lowDeltaTargetQuadraticLinear, lowDeltaTargetQuadraticCurvature,
    lowDeltaSenderQuadraticActionSlope,
    lowDeltaSenderQuadraticCurvature,
    lowDeltaSenderQuadraticIntercept,
    lowDeltaSenderQuadraticVertex,
    lowDeltaSenderQuadraticLinear,
    lowDeltaTargetQuadraticLandingSlope,
    lowDeltaTargetQuadraticLandingIntercept,
    lowDeltaTargetInteriorVertex]
  ring

end Examples
end Sanctions
