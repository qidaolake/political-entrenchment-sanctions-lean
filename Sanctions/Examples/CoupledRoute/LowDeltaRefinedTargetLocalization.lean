import Sanctions.Examples.CoupledRoute.LowDeltaFrozenCoupledLocalization

/-!
# Refined low-delta Target localization

The uniform inherited-state baseline used by the first frozen-center estimate
throws away the fact that the static Sender response is itself Lipschitz in the
Target action.  This file retains that term.  The resulting error is affine in
the Target action displacement and yields a substantially sharper quadratic
localization inequality.
-/

namespace Sanctions
namespace Examples

open Set
open Sanctions.AbstractGame

/-- At a fixed state, the clipped static Sender response is `5/12`-Lipschitz
in the Target action. -/
theorem mwσ_abs_sub_le_action
    (x a b : ℝ) :
    |mwσ x a - mwσ x b| ≤ (5 / 12 : ℝ) * |a - b| := by
  unfold mwσ
  calc
    |max 0 (min 1 ((9 / 8) * x - 1 / 12 - (5 / 12) * a)) -
        max 0 (min 1 ((9 / 8) * x - 1 / 12 - (5 / 12) * b))|
        ≤
          |((9 / 8) * x - 1 / 12 - (5 / 12) * a) -
            ((9 / 8) * x - 1 / 12 - (5 / 12) * b)| :=
      Sanctions.clipS_lipschitz_abs _ _
    _ = (5 / 12 : ℝ) * |a - b| := by
      rw [show
          ((9 / 8 : ℝ) * x - 1 / 12 - (5 / 12) * a) -
              ((9 / 8) * x - 1 / 12 - (5 / 12) * b) =
            -(5 / 12 : ℝ) * (a - b) by ring,
        abs_mul, abs_neg,
        abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 5 / 12)]

/-- Refined comparison with a baseline at the transition generated by the
static Stackelberg action.  The error separates into the dynamic Sender
displacement `K_S/120` and the additional static-response movement
`(5/12)|z-α₀(x)|`, both attenuated by the transition slope `1/100`.
Witness-specific (Rule 22).  The former premises `0 ≤ K_T` and `0 ≤ K_S` are
dropped: they follow from the two Lipschitz bounds. -/
theorem lowDelta_jointTarget_close_static_refined
    (W_T W_S : SBCF) {K_T K_S : ℝ}
    (hWT : Sanctions.AbstractGame.Params.ValueLipschitzWith W_T K_T)
    (hWS : Sanctions.AbstractGame.Params.ValueLipschitzWith W_S K_S)
    {x z : ℝ} (hx : x ∈ Sanctions.S) (hz : z ∈ Sanctions.I) :
    |lowDeltaParams.joint_T_top_integrand W_T W_S x z -
        (lowDeltaStaticTargetObjective x z +
          (9 / 10 : ℝ) * W_T
            (Sanctions.clipS' (lowDeltaParams.F x
              (mwσ x (lowDeltaStaticTargetPolicy x)))))| ≤
      K_S / 120 + (9 / 10 : ℝ) * K_T * (1 / 100) *
        (K_S / 120 + (5 / 12 : ℝ) *
          |z - lowDeltaStaticTargetPolicy x|) := by
  have hKT : 0 ≤ K_T := hWT.nonneg
  let sd := lowDeltaParams.σ_dyn_top W_S x z
  let ss := mwσ x z
  let α := lowDeltaStaticTargetPolicy x
  let sr := mwσ x α
  let yd := Sanctions.clipS' (lowDeltaParams.F x sd)
  let yr := Sanctions.clipS' (lowDeltaParams.F x sr)
  have hsdmem : sd ∈ Sanctions.I :=
    lowDeltaParams.σ_dyn_top_mem_I W_S x z
  have hsPolicy :
      |sd - ss| ≤ K_S / 120 := by
    simpa [sd, ss] using
      lowDelta_sigmaDynTop_abs_sub_staticSender_le
        W_S hWS x z
  have hstage :
      |mwU_T x z sd - mwU_T x z ss| ≤ K_S / 120 :=
    (lowDeltaTargetStage_abs_sub_le hx hz).trans hsPolicy
  have hstatic :
      |ss - sr| ≤ (5 / 12 : ℝ) * |z - α| := by
    simpa [ss, sr, α] using mwσ_abs_sub_le_action x z α
  have hclipF :
      dist yd yr ≤ (1 / 100 : ℝ) * |sd - sr| := by
    unfold yd yr
    rw [lowDeltaParams_F]
    calc
      dist
          (Sanctions.clipS'
            (AbstractGame.affineF (1 / 100) x sd))
          (Sanctions.clipS'
            (AbstractGame.affineF (1 / 100) x sr))
          ≤
            |AbstractGame.affineF (1 / 100) x sd -
              AbstractGame.affineF (1 / 100) x sr| :=
        Sanctions.clipS'_lipschitz_dist _ _
      _ = (1 / 100 : ℝ) * |sd - sr| := by
        unfold AbstractGame.affineF
        rw [show
            (1 - (1 / 100 : ℝ)) * x + (1 / 100) * sd -
                ((1 - (1 / 100 : ℝ)) * x + (1 / 100) * sr) =
              (1 / 100 : ℝ) * (sd - sr) by ring,
          abs_mul,
          abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 100)]
  have hsTri :
      |sd - sr| ≤
        K_S / 120 + (5 / 12 : ℝ) * |z - α| := by
    calc
      |sd - sr| ≤ |sd - ss| + |ss - sr| :=
        abs_sub_le _ _ _
      _ ≤ K_S / 120 + (5 / 12 : ℝ) * |z - α| :=
        add_le_add hsPolicy hstatic
  have hdist :
      dist yd yr ≤ (1 / 100 : ℝ) *
        (K_S / 120 + (5 / 12 : ℝ) * |z - α|) :=
    hclipF.trans
      (mul_le_mul_of_nonneg_left hsTri (by norm_num))
  have hWabs :
      |W_T yd - W_T yr| ≤
        K_T * (1 / 100) *
          (K_S / 120 + (5 / 12 : ℝ) * |z - α|) := by
    calc
      |W_T yd - W_T yr| ≤ K_T * dist yr yd := hWT yr yd
      _ = K_T * dist yd yr := by rw [dist_comm]
      _ ≤ K_T * ((1 / 100 : ℝ) *
          (K_S / 120 + (5 / 12 : ℝ) * |z - α|)) :=
        mul_le_mul_of_nonneg_left hdist hKT
      _ = K_T * (1 / 100) *
          (K_S / 120 + (5 / 12 : ℝ) * |z - α|) := by
        ring
  simp only [AbstractGame.Params.joint_T_top_integrand,
    lowDeltaStaticTargetObjective, lowDeltaParams_U_T,
    lowDeltaParams_β_T]
  rw [show
      mwU_T x z (lowDeltaParams.σ_dyn_top W_S x z) +
            (9 / 10 : ℝ) * W_T
              (Sanctions.clipS'
                (lowDeltaParams.F x
                  (lowDeltaParams.σ_dyn_top W_S x z))) -
          (mwU_T x z (mwσ x z) +
            (9 / 10 : ℝ) * W_T
              (Sanctions.clipS' (lowDeltaParams.F x
                (mwσ x (lowDeltaStaticTargetPolicy x))))) =
        (mwU_T x z (lowDeltaParams.σ_dyn_top W_S x z) -
          mwU_T x z (mwσ x z)) +
        (9 / 10 : ℝ) *
          (W_T (Sanctions.clipS'
            (lowDeltaParams.F x
              (lowDeltaParams.σ_dyn_top W_S x z))) -
            W_T (Sanctions.clipS' (lowDeltaParams.F x
              (mwσ x (lowDeltaStaticTargetPolicy x))))) by
        ring]
  change
    |(mwU_T x z sd - mwU_T x z ss) +
        (9 / 10 : ℝ) * (W_T yd - W_T yr)| ≤
      K_S / 120 + (9 / 10 : ℝ) * K_T * (1 / 100) *
        (K_S / 120 + (5 / 12 : ℝ) * |z - α|)
  calc
    |(mwU_T x z sd - mwU_T x z ss) +
        (9 / 10 : ℝ) * (W_T yd - W_T yr)|
        ≤ |mwU_T x z sd - mwU_T x z ss| +
            |(9 / 10 : ℝ) * (W_T yd - W_T yr)| :=
      abs_add_le _ _
    _ =
        |mwU_T x z sd - mwU_T x z ss| +
          (9 / 10 : ℝ) * |W_T yd - W_T yr| := by
      rw [abs_mul,
        abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 9 / 10)]
    _ ≤ K_S / 120 + (9 / 10 : ℝ) * K_T * (1 / 100) *
        (K_S / 120 + (5 / 12 : ℝ) * |z - α|) :=
      add_le_add hstage
        (by
          have h :=
            mul_le_mul_of_nonneg_left hWabs
              (by norm_num : (0 : ℝ) ≤ 9 / 10)
          simpa [mul_assoc] using h)

/-- Refined quadratic inequality for every maximizer of the reduced dynamic
Target objective.  Unlike a uniform perturbation estimate, the continuation
error grows only linearly with the action displacement.
Witness-specific (Rule 22).  The former premises `0 ≤ K_T` and `0 ≤ K_S` are
dropped: they follow from the two Lipschitz bounds. -/
theorem lowDelta_jointTarget_maximizer_refined_quadratic
    (W_T W_S : SBCF) {K_T K_S : ℝ}
    (hWT : Sanctions.AbstractGame.Params.ValueLipschitzWith W_T K_T)
    (hWS : Sanctions.AbstractGame.Params.ValueLipschitzWith W_S K_S)
    {x a : ℝ} (hx : x ∈ Sanctions.S) (ha : a ∈ Sanctions.I)
    (hmax :
      IsMaxOn
        (lowDeltaParams.joint_T_top_integrand W_T W_S x)
        Sanctions.I a) :
    (a - lowDeltaStaticTargetPolicy x) ^ 2 ≤
      2 * (K_S / 120) +
        (9 / 10 : ℝ) * K_T * (1 / 100) *
          (2 * (K_S / 120) +
            (5 / 12 : ℝ) *
              |a - lowDeltaStaticTargetPolicy x|) := by
  let α := lowDeltaStaticTargetPolicy x
  let c :=
    (9 / 10 : ℝ) * W_T
      (Sanctions.clipS' (lowDeltaParams.F x (mwσ x α)))
  have hαmem : α ∈ Sanctions.I := by
    simpa [α] using lowDeltaStaticTargetPolicy_mem hx
  have hopt :=
    (isMaxOn_iff.mp hmax) α hαmem
  have hgap :=
    lowDeltaStaticTargetPolicy_quadraticGrowth hx ha
  have hclosea :=
    lowDelta_jointTarget_close_static_refined
      W_T W_S hWT hWS hx ha
  have hcloseα :=
    lowDelta_jointTarget_close_static_refined
      W_T W_S hWT hWS hx hαmem
  have hclosea' :
      |lowDeltaParams.joint_T_top_integrand W_T W_S x a -
          (lowDeltaStaticTargetObjective x a + c)| ≤
        K_S / 120 + (9 / 10 : ℝ) * K_T * (1 / 100) *
          (K_S / 120 + (5 / 12 : ℝ) * |a - α|) := by
    simpa [α, c] using hclosea
  have hcloseα' :
      |lowDeltaParams.joint_T_top_integrand W_T W_S x α -
          (lowDeltaStaticTargetObjective x α + c)| ≤
        K_S / 120 + (9 / 10 : ℝ) * K_T * (1 / 100) *
          (K_S / 120) := by
    simpa [α, c] using hcloseα
  have haBounds := abs_le.mp hclosea'
  have hαBounds := abs_le.mp hcloseα'
  change
    (a - α) ^ 2 ≤
      2 * (K_S / 120) +
        (9 / 10 : ℝ) * K_T * (1 / 100) *
          (2 * (K_S / 120) + (5 / 12 : ℝ) * |a - α|)
  change
    (a - α) ^ 2 ≤
      lowDeltaStaticTargetObjective x α -
        lowDeltaStaticTargetObjective x a at hgap
  linarith

end Examples
end Sanctions
