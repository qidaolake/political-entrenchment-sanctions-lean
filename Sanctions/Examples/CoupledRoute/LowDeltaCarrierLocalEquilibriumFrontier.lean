/-
Sanctions/Examples/CoupledRoute/LowDeltaCarrierLocalEquilibriumFrontier.lean

Audit of the former carrier-local coupled-equilibrium packet for the explicit
low-delta economy.

This file retains the exact diagnostic packet

  C_T = coupledCarrierTLip,
  C_S = coupledCarrierS,
  r_T = 4/5,
  r_S = 3/20,

around the actual-transition static-policy evaluation centers. The residual
arithmetic is useful for documenting why the packet fails, but its former
conditional existence theorem exposed numerical policy bounds that were not
derived from the economy. That theorem has been removed. The replacement
generic construction in `ValidatedLocalPerovOnCarriers` derives validation
radii analytically from the actual residual vector and the symbolic Perov
matrix.
-/

import Sanctions.Examples.CoupledRoute.LowDeltaCarrierLocalTargetRow
import Sanctions.Theory.Shocked.ValidatedLocalCoupledEquilibriumOnCarriers

namespace Sanctions
namespace Examples

open Set AbstractGame AbstractGame.ShockedParams
  BoundedContinuousFunction

noncomputable section

/-! ## Carrier-ball packet and its reference point -/

/-- Local Target validation set used by the expanded exact packet. -/
noncomputable def lowDeltaCarrierLocalTargetSet : Set SBCF :=
  coupledCarrierTLip ∩
    Metric.closedBall lowDeltaStaticTargetPolicyCenter
      lowDeltaExpandedTargetRadius

/-- Local Sender validation set used by the expanded exact packet. -/
noncomputable def lowDeltaCarrierLocalSenderSet : Set SBCF :=
  coupledCarrierS ∩
    Metric.closedBall lowDeltaStaticSenderPolicyCenter
      lowDeltaExpandedSenderRadius

/-- The Target reference center lies in the local Target validation set. -/
theorem lowDeltaStaticTargetPolicyCenter_mem_carrierLocalTargetSet :
    lowDeltaStaticTargetPolicyCenter ∈
      lowDeltaCarrierLocalTargetSet := by
  exact
    ⟨lowDeltaStaticTargetPolicyCenter_mem_coupledCarrierTLip,
      Metric.mem_closedBall_self
        (le_of_lt lowDeltaExpandedTargetRadius_pos)⟩

/-- The Sender reference center lies in the local Sender validation set. -/
theorem lowDeltaStaticSenderPolicyCenter_mem_carrierLocalSenderSet :
    lowDeltaStaticSenderPolicyCenter ∈
      lowDeltaCarrierLocalSenderSet := by
  exact
    ⟨lowDeltaStaticSenderPolicyCenter_mem_coupledCarrierS,
      Metric.mem_closedBall_self
        (le_of_lt lowDeltaExpandedSenderRadius_pos)⟩

/-! ## Globally defined operator from locally continuous policy data -/

/-- Coupled row map generated by a locally continuous Target policy.

On the certified carrier-ball product it is exactly the shocked Target and
Sender Bellman pair.  Outside that product it returns the reference center;
that fallback only makes the map globally typed and plays no role in the
local certificate. -/
noncomputable def lowDeltaCarrierLocalCoupledOperator
    (lead : SBCF → SBCF → ℝ → ℝ)
    (lead_cont :
      ∀ V_T V_S,
        V_T ∈ lowDeltaCarrierLocalTargetSet →
        V_S ∈ lowDeltaCarrierLocalSenderSet →
        Continuous (lead V_T V_S)) :
    SBCF × SBCF → SBCF × SBCF := by
  classical
  exact fun z =>
    if hzT : z.1 ∈ lowDeltaCarrierLocalTargetSet then
      if hzS : z.2 ∈ lowDeltaCarrierLocalSenderSet then
        (lowDeltaShocked.targetDynBCF_shock
            (coupledSigmaClamped z.2)
            (coupledSigmaClamped_continuous z.2 hzS.1.2)
            z.1,
          lowDeltaShocked.bellmanS_shock
            (lead z.1 z.2)
            (lead_cont z.1 z.2 hzT hzS)
            z.2)
      else
        (lowDeltaStaticTargetPolicyCenter,
          lowDeltaStaticSenderPolicyCenter)
    else
      (lowDeltaStaticTargetPolicyCenter,
        lowDeltaStaticSenderPolicyCenter)

/-- On the local carrier product, the defined map is exactly the coupled
Target/Sender Bellman pair. -/
theorem lowDeltaCarrierLocalCoupledOperator_eq_of_mem
    (lead : SBCF → SBCF → ℝ → ℝ)
    (lead_cont :
      ∀ V_T V_S,
        V_T ∈ lowDeltaCarrierLocalTargetSet →
        V_S ∈ lowDeltaCarrierLocalSenderSet →
        Continuous (lead V_T V_S))
    (z : SBCF × SBCF)
    (hzT : z.1 ∈ lowDeltaCarrierLocalTargetSet)
    (hzS : z.2 ∈ lowDeltaCarrierLocalSenderSet) :
    lowDeltaCarrierLocalCoupledOperator lead lead_cont z =
      (lowDeltaShocked.targetDynBCF_shock
          (coupledSigmaClamped z.2)
          (coupledSigmaClamped_continuous z.2 hzS.1.2)
          z.1,
        lowDeltaShocked.bellmanS_shock
          (lead z.1 z.2)
          (lead_cont z.1 z.2 hzT hzS)
          z.2) := by
  classical
  simp only [lowDeltaCarrierLocalCoupledOperator,
    dif_pos hzT, dif_pos hzS]

/-! ## Optional Sender center-policy diagnostics

The declarations in this section are exact witness checks only.  They are not
hypotheses of an equilibrium theorem, and no existence conclusion is stated
below. -/

/-- The part of the expanded Sender radius budget left after paying for the
proved static-policy residual and the two coupled row contributions.  It is
available for displacement of the realized Target policy from the static
Target policy at the reference value pair.  This scalar is retained only as
an exact diagnostic; it is not an equilibrium-existence hypothesis. -/
noncomputable def lowDeltaCarrierLocalSenderPolicySlack : ℝ :=
  lowDeltaExpandedSenderResidualAllowance -
    lowDeltaStaticPolicySenderResidualBound

/-- Closed form of the exact Sender center-policy slack. -/
theorem lowDeltaCarrierLocalSenderPolicySlack_eq :
    lowDeltaCarrierLocalSenderPolicySlack =
      2429552350098203266063975021 /
        488157047875412353000038524160 := by
  norm_num [
    lowDeltaCarrierLocalSenderPolicySlack,
    lowDeltaExpandedSenderResidualAllowance,
    lowDeltaStaticPolicySenderResidualBound,
    lowDeltaExpandedTargetRadius,
    lowDeltaExpandedSenderRadius]

/-- The expanded carrier packet has strictly positive room for Target-policy
movement at the Sender reference center. -/
theorem lowDeltaCarrierLocalSenderPolicySlack_pos :
    0 < lowDeltaCarrierLocalSenderPolicySlack := by
  rw [lowDeltaCarrierLocalSenderPolicySlack_eq]
  norm_num

/-- The exact `69/200` center-argmax localization is far larger than the exact
Sender center-policy slack.  Consequently, that localization is only an upper
bound on policy displacement and cannot by itself discharge the much smaller
center residual budget. -/
theorem lowDeltaCarrierLocalSenderPolicySlack_lt_centerArgmaxRadius :
    lowDeltaCarrierLocalSenderPolicySlack < 69 / 200 := by
  rw [lowDeltaCarrierLocalSenderPolicySlack_eq]
  norm_num

/-- A pointwise Target-policy displacement of at most `q` increases the
Sender center residual by at most `q`.

This is the missing comparison with the already-proved static-policy
residual.  It prevents the frontier from silently requiring the realized
dynamic policy to have exactly the same residual as the static policy.
Witness-specific (Rule 22).  The former premise `0 ≤ q` is dropped: it follows
from `hdisp` at the state `0`. -/
theorem lowDeltaCarrierLocal_sender_center_residual_of_policy_displacement
    (α : ℝ → ℝ) (hα : Continuous α) (q : ℝ)
    (hdisp : ∀ x : ↥(Sanctions.S : Set ℝ),
      |α x.val - lowDeltaStaticTargetPolicy x.val| ≤ q) :
    dist
        (lowDeltaShocked.bellmanS_shock α hα
          lowDeltaStaticSenderPolicyCenter)
        lowDeltaStaticSenderPolicyCenter ≤
      lowDeltaStaticPolicySenderResidualBound + q := by
  have hq : 0 ≤ q := (abs_nonneg _).trans (hdisp ⟨0, by norm_num⟩)
  have hpolicy :
      dist
          (lowDeltaShocked.bellmanS_shock α hα
            lowDeltaStaticSenderPolicyCenter)
          (lowDeltaShocked.bellmanS_shock
            lowDeltaStaticTargetPolicy
            lowDeltaStaticTargetPolicy_continuous
            lowDeltaStaticSenderPolicyCenter) ≤ q := by
    rw [BoundedContinuousFunction.dist_le hq]
    intro x
    rw [Real.dist_eq]
    refine le_trans ?_ (hdisp x)
    refine
      lowDeltaShocked.toParams.bellmanS_BCF_policy_pointwise_dist
        α lowDeltaStaticTargetPolicy hα
        lowDeltaStaticTargetPolicy_continuous
        (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter) x _ ?_
    intro s hs
    obtain ⟨hs0, hs1⟩ := hs
    have hkey :
        lowDeltaShocked.toParams.U_S x.val (α x.val) s -
            lowDeltaShocked.toParams.U_S x.val
              (lowDeltaStaticTargetPolicy x.val) s =
          (α x.val - lowDeltaStaticTargetPolicy x.val) *
            (1 - s / 2) := by
      simp only [lowDeltaShocked_toParams, lowDeltaParams_U_S, mwU_S]
      ring
    rw [hkey, abs_mul]
    have habs : |1 - s / 2| ≤ 1 := by
      rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ 1 - s / 2)]
      linarith
    nlinarith [
      habs,
      abs_nonneg (α x.val - lowDeltaStaticTargetPolicy x.val)]
  have hstatic :
      dist
          (lowDeltaShocked.bellmanS_shock
            lowDeltaStaticTargetPolicy
            lowDeltaStaticTargetPolicy_continuous
            lowDeltaStaticSenderPolicyCenter)
          lowDeltaStaticSenderPolicyCenter ≤
        lowDeltaStaticPolicySenderResidualBound := by
    simpa only [lowDeltaStaticPolicySenderResidualBound] using
      lowDeltaStaticSenderPolicyCenter_bellman_residual
  calc
    dist
        (lowDeltaShocked.bellmanS_shock α hα
          lowDeltaStaticSenderPolicyCenter)
        lowDeltaStaticSenderPolicyCenter
      ≤ dist
          (lowDeltaShocked.bellmanS_shock α hα
            lowDeltaStaticSenderPolicyCenter)
          (lowDeltaShocked.bellmanS_shock
            lowDeltaStaticTargetPolicy
            lowDeltaStaticTargetPolicy_continuous
            lowDeltaStaticSenderPolicyCenter) +
        dist
          (lowDeltaShocked.bellmanS_shock
            lowDeltaStaticTargetPolicy
            lowDeltaStaticTargetPolicy_continuous
            lowDeltaStaticSenderPolicyCenter)
          lowDeltaStaticSenderPolicyCenter :=
        dist_triangle _ _ _
    _ ≤ q + lowDeltaStaticPolicySenderResidualBound :=
      add_le_add hpolicy hstatic
    _ = lowDeltaStaticPolicySenderResidualBound + q := by ring

/-- Any policy displacement within the exact slack preserves the expanded
Sender radius inequality. -/
theorem lowDeltaCarrierLocal_sender_radius_of_policy_displacement
    (q : ℝ) (hq : q ≤ lowDeltaCarrierLocalSenderPolicySlack) :
    (lowDeltaStaticPolicySenderResidualBound + q) +
          (2880 / 37877) * lowDeltaExpandedTargetRadius +
          (8697049946379 / 15525967670038) *
            lowDeltaExpandedSenderRadius
        ≤ lowDeltaExpandedSenderRadius := by
  apply lowDeltaSenderResidual_fits_expandedRadius_of_le_allowance
  unfold lowDeltaCarrierLocalSenderPolicySlack at hq
  linarith

/-- The derived realized-policy Sender residual fits the honest maximum
residual allowance of the expanded packet.  Witness-specific (Rule 22).  The
former premise `0 ≤ q` is dropped: it follows from `hdisp`. -/
theorem lowDeltaCarrierLocal_sender_center_residual_le_allowance
    (α : ℝ → ℝ) (hα : Continuous α) (q : ℝ)
    (hqSlack : q ≤ lowDeltaCarrierLocalSenderPolicySlack)
    (hdisp : ∀ x : ↥(Sanctions.S : Set ℝ),
      |α x.val - lowDeltaStaticTargetPolicy x.val| ≤ q) :
    dist
        (lowDeltaShocked.bellmanS_shock α hα
          lowDeltaStaticSenderPolicyCenter)
        lowDeltaStaticSenderPolicyCenter ≤
      lowDeltaExpandedSenderResidualAllowance := by
  have hres :=
    lowDeltaCarrierLocal_sender_center_residual_of_policy_displacement
      α hα q hdisp
  unfold lowDeltaCarrierLocalSenderPolicySlack at hqSlack
  linarith

/-! ## Audited frontier status

The former numerical conditional-existence wrapper has been removed. Its
policy-displacement threshold and exact two-coordinate selector coefficients
were proof-budget artifacts, not properties derived from the low-adjustment
economy's primitives. The generic analytic replacement now constructs the
local radii from the actual residual vector and the symbolic Perov matrix in
`ValidatedLocalPerovOnCarriers`; a low-adjustment equilibrium corollary should
be reinstated here only after the endogenous Target selector, its local row
estimate, and Sender carrier preservation are proved rather than hypothesized.

The lemmas above remain useful as exact diagnostics of why the previous static
reference packet did not close. No equilibrium-existence claim is made in this
file. -/

end
end Examples
end Sanctions
