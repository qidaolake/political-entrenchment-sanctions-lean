/-
Sanctions/Examples/CoupledRoute/LowDeltaStaticPolicyTargetResidual.lean

Exact Target Bellman residual bound at the actual-transition static-policy
evaluation center.

The reduced dynamic Target objective is compared with the exact static
Stackelberg objective plus the continuation value generated by the static
policy.  The refined affine action-error estimate and global static Target
quadratic growth yield a completed-square supremum bound.

This is a valid continuum upper bound.  Its size is audited separately; no
claim is made here that it closes a chosen local Perov radius.
-/

import Sanctions.Examples.CoupledRoute.LowDeltaStaticPolicyCenterResidual
import Sanctions.Examples.CoupledRoute.LowDeltaRefinedTargetLocalization

namespace Sanctions
namespace Examples

open Set
open AbstractGame
open BoundedContinuousFunction

/-- Moving averaging preserves the sharp state-Lipschitz modulus of the
actual-transition Target policy-evaluation center. -/
theorem lowDeltaStaticTargetPolicyCenter_smear_valueLipschitz :
    Sanctions.AbstractGame.Params.ValueLipschitzWith
      (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
      (3855250 / 142269) := by
  simpa only [lowDeltaShocked] using
    (Sanctions.AbstractGame.movAvgShockedParams_smear_valueLipschitz
      lowDeltaParams lowDeltaH_pos
      (by norm_num : (0 : ℝ) ≤ 3855250 / 142269)
      lowDeltaStaticTargetPolicyCenter_valueLipschitz)

/-- Whole-line continuous extension of the greatest dynamic Sender selector
at the actual-transition Sender center. -/
theorem lowDeltaStaticSenderPolicyCenter_sigmaDynTop_clamped_continuous :
    Continuous (fun xa : ℝ × ℝ =>
      lowDeltaParams.σ_dyn_top_clamped
        (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
        xa.1 xa.2) := by
  exact
    lowDeltaParams.σ_dyn_top_clamped_continuous
      (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
      lowDeltaStaticSenderPolicyCenter_sigmaDynTop_continuous

/-- Target Bellman row evaluated at the two actual-transition static-policy
comparison centers. -/
noncomputable def lowDeltaStaticPolicyTargetBellman : SBCF :=
  lowDeltaShocked.targetDynBCF_shock
    (lowDeltaParams.σ_dyn_top_clamped
      (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter))
    lowDeltaStaticSenderPolicyCenter_sigmaDynTop_clamped_continuous
    lowDeltaStaticTargetPolicyCenter

/-- Pointwise `sSup` representation of the Target Bellman row. -/
theorem lowDeltaStaticPolicyTargetBellman_apply
    (x : ↥(Sanctions.S : Set ℝ)) :
    lowDeltaStaticPolicyTargetBellman x =
      sSup ((fun a =>
        lowDeltaParams.joint_T_top_integrand
          (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
          (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
          x.val a) '' Sanctions.I) := by
  simp only [lowDeltaStaticPolicyTargetBellman,
    AbstractGame.ShockedParams.targetDynBCF_shock,
    Sanctions.AbstractGame.Params.targetDynBCF_apply,
    Sanctions.AbstractGame.Params.targetDynBellmanOn,
    Sanctions.AbstractGame.Params.targetDynIntegrand,
    Sanctions.AbstractGame.Params.joint_T_top_integrand,
    lowDeltaShocked_toParams,
    lowDeltaParams.σ_dyn_top_clamped_eq_of_mem
      (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
      x.property]

/-- Refined affine error envelope for the Target objective at the
actual-transition policy-evaluation centers. -/
theorem lowDeltaStaticPolicyTarget_close_static
    {x a : ℝ} (hx : x ∈ Sanctions.S) (ha : a ∈ Sanctions.I) :
    |lowDeltaParams.joint_T_top_integrand
          (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
          (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
          x a -
        (lowDeltaStaticTargetObjective x a +
          (9 / 10 : ℝ) *
            (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
              (Sanctions.clipS' (lowDeltaParams.F x
                (lowDeltaStaticSenderPolicy x))))| ≤
      (1 + (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100)) *
          ((16362665 / 4046689 : ℝ) / 120) +
        ((9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100) *
          (5 / 12)) *
          |a - lowDeltaStaticTargetPolicy x| := by
  have h :=
    lowDelta_jointTarget_close_static_refined
      (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
      (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
      (K_T := (3855250 / 142269 : ℝ))
      (K_S := (16362665 / 4046689 : ℝ))
      lowDeltaStaticTargetPolicyCenter_smear_valueLipschitz
      lowDeltaStaticSenderPolicyCenter_smear_valueLipschitz
      hx ha
  simpa only [lowDeltaStaticSenderPolicy] using
    (show
      |lowDeltaParams.joint_T_top_integrand
            (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
            (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
            x a -
          (lowDeltaStaticTargetObjective x a +
            (9 / 10 : ℝ) *
              (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
                (Sanctions.clipS' (lowDeltaParams.F x
                  (mwσ x (lowDeltaStaticTargetPolicy x)))))| ≤
        (1 + (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100)) *
            ((16362665 / 4046689 : ℝ) / 120) +
          ((9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100) *
            (5 / 12)) *
            |a - lowDeltaStaticTargetPolicy x| by
      convert h using 1
      ring)

/-- Pointwise Target Bellman residual at the actual-transition static-policy
evaluation center. -/
theorem lowDeltaStaticPolicyTargetCenter_bellman_residual_pointwise
    (x : ↥(Sanctions.S : Set ℝ)) :
    |lowDeltaStaticPolicyTargetBellman x -
        lowDeltaStaticTargetPolicyCenter x| ≤
      (1 + (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100)) *
          ((16362665 / 4046689 : ℝ) / 120) +
        ((9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100) *
          (5 / 12)) ^ 2 / 4 := by
  let f : ℝ → ℝ := lowDeltaStaticTargetObjective x.val
  let J : ℝ → ℝ := fun a =>
    lowDeltaParams.joint_T_top_integrand
      (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
      (lowDeltaShocked.smear lowDeltaStaticSenderPolicyCenter)
      x.val a
  let a₀ : ℝ := lowDeltaStaticTargetPolicy x.val
  let c : ℝ :=
    (9 / 10 : ℝ) *
      (lowDeltaShocked.smear lowDeltaStaticTargetPolicyCenter)
        (Sanctions.clipS' (lowDeltaParams.F x.val
          (lowDeltaStaticSenderPolicy x.val)))
  let A : ℝ :=
    (1 + (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100)) *
      ((16362665 / 4046689 : ℝ) / 120)
  let L : ℝ :=
    (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100) * (5 / 12)
  have ha₀ : a₀ ∈ Sanctions.I := by
    simpa only [a₀] using lowDeltaStaticTargetPolicy_mem x.property
  have hgrowth :
      ∀ a ∈ Sanctions.I,
        (1 : ℝ) * (a - a₀) ^ 2 ≤ f a₀ - f a := by
    intro a ha
    simpa only [one_mul, f, a₀] using
      lowDeltaStaticTargetPolicy_quadraticGrowth x.property ha
  have hclose :
      ∀ a ∈ Sanctions.I,
        |J a - (f a + c)| ≤ A + L * |a - a₀| := by
    intro a ha
    simpa only [J, f, c, A, L, a₀] using
      lowDeltaStaticPolicyTarget_close_static x.property ha
  have hsup :=
    Sanctions.abs_sSup_sub_quadraticGrowth_base_le_of_affine_error
      ha₀ (by norm_num : (0 : ℝ) < 1)
      (by norm_num : (0 : ℝ) ≤
        (9 / 10) * (3855250 / 142269) * (1 / 100) * (5 / 12))
      hgrowth hclose
  have hbase :
      f a₀ + c = lowDeltaStaticTargetPolicyCenter x := by
    have hs₀ :
        lowDeltaStaticSenderPolicy x.val ∈ Sanctions.I :=
      lowDeltaStaticSenderPolicy_mem x.val
    have hF :
        lowDeltaParams.F x.val
            (lowDeltaStaticSenderPolicy x.val) ∈ Sanctions.S :=
      lowDeltaParams.F_mem x.val
        (lowDeltaStaticSenderPolicy x.val) x.property hs₀
    have hF' :
        lowDeltaParams.F x.val
            (mwσ x.val (lowDeltaStaticTargetPolicy x.val)) ∈ Sanctions.S := by
      simpa only [lowDeltaStaticSenderPolicy] using hF
    rw [lowDeltaStaticTargetPolicyCenter_eq]
    simp only [lowDeltaFrozenTargetStage_apply,
      lowDeltaStaticPolicyPullback_apply, f, a₀, c,
      lowDeltaStaticPolicyDrift, lowDeltaStaticTargetObjective,
      lowDeltaStaticSenderPolicy, lowDeltaShocked_smear,
      Sanctions.movAvgBCF_apply]
    rw [Sanctions.clipS'_val_eq_of_mem hF']
  rw [lowDeltaStaticPolicyTargetBellman_apply, ← hbase]
  convert hsup using 1
  norm_num [J, A, L]

/-- Sup-norm form of the exact Target residual upper bound. -/
theorem lowDeltaStaticPolicyTargetCenter_bellman_residual :
    dist lowDeltaStaticPolicyTargetBellman
        lowDeltaStaticTargetPolicyCenter ≤
      (1 + (9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100)) *
          ((16362665 / 4046689 : ℝ) / 120) +
        ((9 / 10 : ℝ) * (3855250 / 142269) * (1 / 100) *
          (5 / 12)) ^ 2 / 4 := by
  rw [BoundedContinuousFunction.dist_le (by positivity)]
  intro x
  rw [Real.dist_eq]
  exact lowDeltaStaticPolicyTargetCenter_bellman_residual_pointwise x

end Examples
end Sanctions
