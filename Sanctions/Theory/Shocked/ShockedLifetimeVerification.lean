/-
Sanctions/Theory/Shocked/ShockedLifetimeVerification.lean

Infinite-horizon verification for the concrete uniform-box shock.

`ShockedOneStepVerification` extracts the two Bellman rows from
`ShockedFeedbackStackelbergEquilibriumTop`.  Those rows are only one-period
statements for an abstract `ShockedParams`, because nonexpansiveness of an
abstract smear does not make it an expectation.  Here the shock is the actual
`movAvgShockedParams` box kernel.  Feasible transitions lie in the state
interval, so the deterministic clip in the Bellman row disappears and the
continuation is exactly the positive, unital closed-loop pullback constructed
in `FeynmanKacVerification`.

The first results cover arbitrary time-dependent continuous feedback
deviations.  They do not rely on convergence of a numerical value iteration
and add no field or hypothesis to the model or equilibrium structures.
-/

import Sanctions.Theory.Shocked.ShockedOneStepVerification
import Sanctions.Theory.Shocked.MovingAverageShock
import Sanctions.Foundations.FeynmanKacVerification
import Sanctions.Theory.Bellman.InvariantBall

namespace Sanctions
namespace AbstractGame
namespace ShockedParams

open Set BoundedContinuousFunction
open FeynmanKacVerification

noncomputable section

/-! ## Sender deviations -/

/-- The Sender's stage payoff under a continuous feedback rule, represented as
a bounded continuous observable on the compact state interval. -/
noncomputable def senderStageObservable
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ↥(Sanctions.S : Set ℝ) → ℝ) (hs : Continuous s) : StateBCF :=
  show StateBCF from
    (BoundedContinuousFunction.mkOfCompact
      ⟨fun x => p.U_S x.val (E.α x.val) (s x),
        p.U_S_continuous.comp
          (continuous_subtype_val.prodMk
            ((E.hα.comp continuous_subtype_val).prodMk hs))⟩ : SBCF)

/-- The pre-noise closed-loop drift generated by a Sender feedback rule. -/
noncomputable def senderClosedLoopDrift
    (p : Params) (s : ↥(Sanctions.S : Set ℝ) → ℝ) :
    ↥(Sanctions.S : Set ℝ) → ℝ :=
  fun x => p.F x.val (s x)

theorem senderClosedLoopDrift_continuous
    {p : Params} (s : ↥(Sanctions.S : Set ℝ) → ℝ) (hs : Continuous s) :
    Continuous (senderClosedLoopDrift p s) :=
  p.F_continuous.comp (continuous_subtype_val.prodMk hs)

/-- Every feasible continuous Sender deviation satisfies the equilibrium
Sender value's Bellman upper-bound row under the concrete box pullback. -/
theorem sender_deviation_bellman_row
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ↥(Sanctions.S : Set ℝ) → ℝ) (hs : Continuous s)
    (hs_mem : ∀ x, s x ∈ Sanctions.I) :
    senderStageObservable hh E s hs + p.β_S •
        (closedLoopPullbackOperator (senderClosedLoopDrift p s)
          (senderClosedLoopDrift_continuous s hs) h hh).toFun E.V_S ≤
      (show StateBCF from E.V_S) := by
  intro x
  have hFmem : p.F x.val (s x) ∈ Sanctions.S :=
    p.F_mem x.val (s x) x.property (hs_mem x)
  have hrow := sender_shocked_bellman_le
    (sp := movAvgShockedParams p hh) E x.property (hs_mem x)
  change p.U_S x.val (E.α x.val) (s x) + p.β_S *
    movAvgReal h E.V_S (clipS' (p.F x.val (s x))).val ≤ E.V_S x at hrow
  rw [clipS'_val_eq_of_mem hFmem] at hrow
  simpa [senderStageObservable, senderClosedLoopDrift,
    closedLoopPullbackOperator] using hrow

/-- Sup-norm bounded continuous functions are bounded by their norm times the
order unit.  This discharges the terminal-value condition in the abstract
Feynman--Kac telescope. -/
theorem stateBCF_orderBounded_norm (f : StateBCF) :
    OrderBoundedByOne f ‖(show SBCF from f)‖ := by
  constructor
  · intro x
    have h := BoundedContinuousFunction.norm_coe_le_norm
      (show SBCF from f) x
    have habs : |f x| ≤ ‖(show SBCF from f)‖ := by
      simpa [Real.norm_eq_abs] using h
    simpa using (abs_le.mp habs).1
  · intro x
    have h := BoundedContinuousFunction.norm_coe_le_norm
      (show SBCF from f) x
    have habs : |f x| ≤ ‖(show SBCF from f)‖ := by
      simpa [Real.norm_eq_abs] using h
    simpa using (abs_le.mp habs).2

/-- **Infinite-horizon Sender verification.** From every initial state, the
discounted expected payoff of any time-dependent sequence of feasible
continuous Sender feedback deviations is at most the equilibrium Sender
value.  The expectation is the iterated uniform-box transition encoded by
`closedLoopPullbackSequence`. -/
theorem sender_continuous_deviation_payoff_le_value
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ℕ → ↥(Sanctions.S : Set ℝ) → ℝ)
    (hs : ∀ n, Continuous (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I)
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun n => senderClosedLoopDrift p (s n))
          (fun n => senderClosedLoopDrift_continuous (s n) (hs n)) h hh)
        (pointEvaluation x0) p.β_S
        (fun n => senderStageObservable hh E (s n) (hs n)) ≤ E.V_S x0 := by
  obtain ⟨M, _hM, hcube⟩ := p.cube_bound_U_S
  apply expectedDiscountedPayoff_le_value_of_order_bounds
    (M_u := M) (M_V := ‖E.V_S‖)
  · exact p.β_S_mem.1
  · exact p.β_S_mem.2
  · intro n
    exact sender_deviation_bellman_row hh E (s n) (hs n) (hs_mem n)
  · intro n
    constructor
    · intro x
      have habs := hcube x.val x.property (E.α x.val)
        (E.α_mem x.val x.property) (s n x) (hs_mem n x)
      simpa [senderStageObservable] using (abs_le.mp habs).1
    · intro x
      have habs := hcube x.val x.property (E.α x.val)
        (E.α_mem x.val x.property) (s n x) (hs_mem n x)
      simpa [senderStageObservable] using (abs_le.mp habs).2
  · exact stateBCF_orderBounded_norm (show StateBCF from E.V_S)

/-! ## The equilibrium Sender path -/

/-- The Sender feedback rule realized at the equilibrium Target policy. -/
noncomputable def equilibriumSenderPolicy
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ↥(Sanctions.S : Set ℝ) → ℝ :=
  fun x =>
    p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S) x.val (E.α x.val)

theorem equilibriumSenderPolicy_continuous
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2)) :
    Continuous (equilibriumSenderPolicy hh E) :=
  hσc.comp
    (continuous_id.prodMk (E.hα.comp continuous_subtype_val))

theorem equilibriumSenderPolicy_mem
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (x : ↥(Sanctions.S : Set ℝ)) :
    equilibriumSenderPolicy hh E x ∈ Sanctions.I :=
  p.σ_dyn_top_mem_I
    ((movAvgShockedParams p hh).smear E.V_S) x.val (E.α x.val)

/-- The Sender Bellman row is an equality along the equilibrium feedback
rule. -/
theorem sender_equilibrium_bellman_row_eq
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2)) :
    senderStageObservable hh E (equilibriumSenderPolicy hh E)
        (equilibriumSenderPolicy_continuous hh E hσc) + p.β_S •
      (closedLoopPullbackOperator
        (senderClosedLoopDrift p (equilibriumSenderPolicy hh E))
        (senderClosedLoopDrift_continuous _
          (equilibriumSenderPolicy_continuous hh E hσc)) h hh).toFun E.V_S =
      (show StateBCF from E.V_S) := by
  ext x
  have hs_mem := equilibriumSenderPolicy_mem hh E x
  have hFmem :
      p.F x.val (equilibriumSenderPolicy hh E x) ∈ Sanctions.S :=
    p.F_mem x.val _ x.property hs_mem
  have hrow := sender_shocked_bellman_eq_at_top_response
    (sp := movAvgShockedParams p hh) E x.property
  change E.V_S x =
    p.U_S x.val (E.α x.val) (equilibriumSenderPolicy hh E x) +
      p.β_S * movAvgReal h E.V_S
        (clipS' (p.F x.val (equilibriumSenderPolicy hh E x))).val at hrow
  rw [clipS'_val_eq_of_mem hFmem] at hrow
  simpa [senderStageObservable, senderClosedLoopDrift,
    closedLoopPullbackOperator] using hrow.symm

/-- The discounted expected payoff generated by the equilibrium Sender rule is
exactly the equilibrium Sender value. -/
theorem sender_equilibrium_expected_payoff_eq_value
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun _n =>
            senderClosedLoopDrift p (equilibriumSenderPolicy hh E))
          (fun _n => senderClosedLoopDrift_continuous _
            (equilibriumSenderPolicy_continuous hh E hσc)) h hh)
        (pointEvaluation x0) p.β_S
        (fun _n => senderStageObservable hh E
          (equilibriumSenderPolicy hh E)
          (equilibriumSenderPolicy_continuous hh E hσc)) =
      E.V_S x0 := by
  obtain ⟨M, _hM, hcube⟩ := p.cube_bound_U_S
  apply expectedDiscountedPayoff_eq_value_of_order_bounds
    (M_u := M) (M_V := ‖E.V_S‖)
  · exact p.β_S_mem.1
  · exact p.β_S_mem.2
  · intro _n
    exact sender_equilibrium_bellman_row_eq hh E hσc
  · intro _n
    constructor
    · intro x
      have habs := hcube x.val x.property (E.α x.val)
        (E.α_mem x.val x.property) (equilibriumSenderPolicy hh E x)
        (equilibriumSenderPolicy_mem hh E x)
      simpa [senderStageObservable] using (abs_le.mp habs).1
    · intro x
      have habs := hcube x.val x.property (E.α x.val)
        (E.α_mem x.val x.property) (equilibriumSenderPolicy hh E x)
        (equilibriumSenderPolicy_mem hh E x)
      simpa [senderStageObservable] using (abs_le.mp habs).2
  · exact stateBCF_orderBounded_norm (show StateBCF from E.V_S)

/-- **Sender lifetime optimality.** No time-dependent feasible continuous
Sender feedback deviation yields more discounted expected payoff than the
stationary equilibrium Sender rule. -/
theorem sender_continuous_deviation_payoff_le_equilibrium
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (s : ℕ → ↥(Sanctions.S : Set ℝ) → ℝ)
    (hs : ∀ n, Continuous (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I)
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun n => senderClosedLoopDrift p (s n))
          (fun n => senderClosedLoopDrift_continuous (s n) (hs n)) h hh)
        (pointEvaluation x0) p.β_S
        (fun n => senderStageObservable hh E (s n) (hs n)) ≤
      expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun _n =>
            senderClosedLoopDrift p (equilibriumSenderPolicy hh E))
          (fun _n => senderClosedLoopDrift_continuous _
            (equilibriumSenderPolicy_continuous hh E hσc)) h hh)
        (pointEvaluation x0) p.β_S
        (fun _n => senderStageObservable hh E
          (equilibriumSenderPolicy hh E)
          (equilibriumSenderPolicy_continuous hh E hσc)) := by
  rw [sender_equilibrium_expected_payoff_eq_value hh E hσc x0]
  exact sender_continuous_deviation_payoff_le_value hh E s hs hs_mem x0

/-! ## Target deviations and the realized Sender response -/

/-- The Sender action induced by a Target feedback rule when the Sender keeps
the equilibrium continuation value and upper best-response selector. -/
noncomputable def targetInducedSenderPolicy
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) :
    ↥(Sanctions.S : Set ℝ) → ℝ :=
  fun x =>
    p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S) x.val (a x)

theorem targetInducedSenderPolicy_continuous
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) (ha : Continuous a) :
    Continuous (targetInducedSenderPolicy hh E a) :=
  hσc.comp (continuous_id.prodMk ha)

theorem targetInducedSenderPolicy_mem
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ↥(Sanctions.S : Set ℝ) → ℝ)
    (x : ↥(Sanctions.S : Set ℝ)) :
    targetInducedSenderPolicy hh E a x ∈ Sanctions.I :=
  p.σ_dyn_top_mem_I
    ((movAvgShockedParams p hh).smear E.V_S) x.val (a x)

/-- The Target's stage payoff after substituting the realized dynamic Sender
response to its feedback action. -/
noncomputable def targetStageObservable
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) (ha : Continuous a) : StateBCF :=
  show StateBCF from
    (BoundedContinuousFunction.mkOfCompact
      ⟨fun x =>
          p.U_T x.val (a x) (targetInducedSenderPolicy hh E a x),
        p.U_T_continuous.comp
          (continuous_subtype_val.prodMk
            (ha.prodMk
              (targetInducedSenderPolicy_continuous hh E hσc a ha)))⟩ : SBCF)

/-- The pre-noise Target-path drift after substituting the realized Sender
response. -/
noncomputable def targetClosedLoopDrift
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) :
    ↥(Sanctions.S : Set ℝ) → ℝ :=
  fun x => p.F x.val (targetInducedSenderPolicy hh E a x)

theorem targetClosedLoopDrift_continuous
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) (ha : Continuous a) :
    Continuous (targetClosedLoopDrift hh E a) :=
  p.F_continuous.comp
    (continuous_subtype_val.prodMk
      (targetInducedSenderPolicy_continuous hh E hσc a ha))

/-- Every feasible continuous Target deviation satisfies the equilibrium
Target value's Bellman upper-bound row after substituting the realized Sender
best response. -/
theorem target_deviation_bellman_row
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ↥(Sanctions.S : Set ℝ) → ℝ) (ha : Continuous a)
    (ha_mem : ∀ x, a x ∈ Sanctions.I) :
    targetStageObservable hh E hσc a ha + p.β_T •
        (closedLoopPullbackOperator (targetClosedLoopDrift hh E a)
          (targetClosedLoopDrift_continuous hh E hσc a ha) h hh).toFun E.V_T ≤
      (show StateBCF from E.V_T) := by
  intro x
  have hs_mem := targetInducedSenderPolicy_mem hh E a x
  have hFmem :
      p.F x.val (targetInducedSenderPolicy hh E a x) ∈ Sanctions.S :=
    p.F_mem x.val _ x.property hs_mem
  have hrow := target_shocked_bellman_le
    (sp := movAvgShockedParams p hh) E x.property (ha_mem x)
  change
    p.U_T x.val (a x) (targetInducedSenderPolicy hh E a x) +
      p.β_T * movAvgReal h E.V_T
        (clipS'
          (p.F x.val (targetInducedSenderPolicy hh E a x))).val ≤
      E.V_T x at hrow
  rw [clipS'_val_eq_of_mem hFmem] at hrow
  simpa [targetStageObservable, targetClosedLoopDrift,
    closedLoopPullbackOperator] using hrow

/-- **Infinite-horizon Target verification.** From every initial state, the
discounted expected payoff of any time-dependent sequence of feasible
continuous Target feedback deviations, after substituting the realized
dynamic Sender response in every period, is at most the equilibrium Target
value. -/
theorem target_continuous_deviation_payoff_le_value
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ℕ → ↥(Sanctions.S : Set ℝ) → ℝ)
    (ha : ∀ n, Continuous (a n))
    (ha_mem : ∀ n x, a n x ∈ Sanctions.I)
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun n => targetClosedLoopDrift hh E (a n))
          (fun n => targetClosedLoopDrift_continuous
            hh E hσc (a n) (ha n)) h hh)
        (pointEvaluation x0) p.β_T
        (fun n => targetStageObservable hh E hσc (a n) (ha n)) ≤
      E.V_T x0 := by
  obtain ⟨M, _hM, hcube⟩ := p.cube_bound_U_T
  apply expectedDiscountedPayoff_le_value_of_order_bounds
    (M_u := M) (M_V := ‖E.V_T‖)
  · exact p.β_T_mem.1
  · exact p.β_T_mem.2
  · intro n
    exact target_deviation_bellman_row
      hh E hσc (a n) (ha n) (ha_mem n)
  · intro n
    constructor
    · intro x
      have habs := hcube x.val x.property (a n x) (ha_mem n x)
        (targetInducedSenderPolicy hh E (a n) x)
        (targetInducedSenderPolicy_mem hh E (a n) x)
      simpa [targetStageObservable] using (abs_le.mp habs).1
    · intro x
      have habs := hcube x.val x.property (a n x) (ha_mem n x)
        (targetInducedSenderPolicy hh E (a n) x)
        (targetInducedSenderPolicy_mem hh E (a n) x)
      simpa [targetStageObservable] using (abs_le.mp habs).2
  · exact stateBCF_orderBounded_norm (show StateBCF from E.V_T)

/-! ## The equilibrium Target path -/

/-- The equilibrium Target feedback policy restricted to feasible states. -/
noncomputable def equilibriumTargetPolicy
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ↥(Sanctions.S : Set ℝ) → ℝ :=
  fun x => E.α x.val

theorem equilibriumTargetPolicy_continuous
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    Continuous (equilibriumTargetPolicy hh E) :=
  E.hα.comp continuous_subtype_val

theorem equilibriumTargetPolicy_mem
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (x : ↥(Sanctions.S : Set ℝ)) :
    equilibriumTargetPolicy hh E x ∈ Sanctions.I :=
  E.α_mem x.val x.property

/-- The Target Bellman row is an equality along the equilibrium feedback
policy and its realized Sender response. -/
theorem target_equilibrium_bellman_row_eq
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2)) :
    targetStageObservable hh E hσc (equilibriumTargetPolicy hh E)
        (equilibriumTargetPolicy_continuous hh E) + p.β_T •
      (closedLoopPullbackOperator
        (targetClosedLoopDrift hh E (equilibriumTargetPolicy hh E))
        (targetClosedLoopDrift_continuous hh E hσc _
          (equilibriumTargetPolicy_continuous hh E)) h hh).toFun E.V_T =
      (show StateBCF from E.V_T) := by
  ext x
  have hs_mem :=
    targetInducedSenderPolicy_mem hh E (equilibriumTargetPolicy hh E) x
  have hFmem :
      p.F x.val
          (targetInducedSenderPolicy hh E
            (equilibriumTargetPolicy hh E) x) ∈ Sanctions.S :=
    p.F_mem x.val _ x.property hs_mem
  have hrow := target_shocked_bellman_eq_at_policy
    (sp := movAvgShockedParams p hh) E x.property
  change E.V_T x =
    p.U_T x.val (equilibriumTargetPolicy hh E x)
        (targetInducedSenderPolicy hh E
          (equilibriumTargetPolicy hh E) x) +
      p.β_T * movAvgReal h E.V_T
        (clipS' (p.F x.val
          (targetInducedSenderPolicy hh E
            (equilibriumTargetPolicy hh E) x))).val at hrow
  rw [clipS'_val_eq_of_mem hFmem] at hrow
  simpa [targetStageObservable, targetClosedLoopDrift,
    closedLoopPullbackOperator] using hrow.symm

/-- The discounted expected payoff generated by the equilibrium Target policy
and realized Sender response is exactly the equilibrium Target value. -/
theorem target_equilibrium_expected_payoff_eq_value
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun _n =>
            targetClosedLoopDrift hh E (equilibriumTargetPolicy hh E))
          (fun _n => targetClosedLoopDrift_continuous hh E hσc _
            (equilibriumTargetPolicy_continuous hh E)) h hh)
        (pointEvaluation x0) p.β_T
        (fun _n => targetStageObservable hh E hσc
          (equilibriumTargetPolicy hh E)
          (equilibriumTargetPolicy_continuous hh E)) =
      E.V_T x0 := by
  obtain ⟨M, _hM, hcube⟩ := p.cube_bound_U_T
  apply expectedDiscountedPayoff_eq_value_of_order_bounds
    (M_u := M) (M_V := ‖E.V_T‖)
  · exact p.β_T_mem.1
  · exact p.β_T_mem.2
  · intro _n
    exact target_equilibrium_bellman_row_eq hh E hσc
  · intro _n
    constructor
    · intro x
      have habs := hcube x.val x.property
        (equilibriumTargetPolicy hh E x)
        (equilibriumTargetPolicy_mem hh E x)
        (targetInducedSenderPolicy hh E (equilibriumTargetPolicy hh E) x)
        (targetInducedSenderPolicy_mem
          hh E (equilibriumTargetPolicy hh E) x)
      simpa [targetStageObservable] using (abs_le.mp habs).1
    · intro x
      have habs := hcube x.val x.property
        (equilibriumTargetPolicy hh E x)
        (equilibriumTargetPolicy_mem hh E x)
        (targetInducedSenderPolicy hh E (equilibriumTargetPolicy hh E) x)
        (targetInducedSenderPolicy_mem
          hh E (equilibriumTargetPolicy hh E) x)
      simpa [targetStageObservable] using (abs_le.mp habs).2
  · exact stateBCF_orderBounded_norm (show StateBCF from E.V_T)

/-- **Target lifetime optimality.** No time-dependent feasible continuous
Target feedback deviation, after substituting the realized dynamic Sender
response, yields more discounted expected payoff than the stationary
equilibrium Target policy. -/
theorem target_continuous_deviation_payoff_le_equilibrium
    {p : Params} {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (hσc : Continuous (fun xa : ↥(Sanctions.S : Set ℝ) × ℝ =>
      p.σ_dyn_top ((movAvgShockedParams p hh).smear E.V_S)
        xa.1.val xa.2))
    (a : ℕ → ↥(Sanctions.S : Set ℝ) → ℝ)
    (ha : ∀ n, Continuous (a n))
    (ha_mem : ∀ n x, a n x ∈ Sanctions.I)
    (x0 : ↥(Sanctions.S : Set ℝ)) :
    expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun n => targetClosedLoopDrift hh E (a n))
          (fun n => targetClosedLoopDrift_continuous
            hh E hσc (a n) (ha n)) h hh)
        (pointEvaluation x0) p.β_T
        (fun n => targetStageObservable hh E hσc (a n) (ha n)) ≤
      expectedDiscountedPayoff
        (closedLoopPullbackSequence
          (fun _n =>
            targetClosedLoopDrift hh E (equilibriumTargetPolicy hh E))
          (fun _n => targetClosedLoopDrift_continuous hh E hσc _
            (equilibriumTargetPolicy_continuous hh E)) h hh)
        (pointEvaluation x0) p.β_T
        (fun _n => targetStageObservable hh E hσc
          (equilibriumTargetPolicy hh E)
          (equilibriumTargetPolicy_continuous hh E)) := by
  rw [target_equilibrium_expected_payoff_eq_value hh E hσc x0]
  exact target_continuous_deviation_payoff_le_value
    hh E hσc a ha ha_mem x0

end
