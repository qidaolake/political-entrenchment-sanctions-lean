/-
Sanctions/Theory/Shocked/ShockedBorelLifetimeVerification.lean

Model-specific wiring from the shocked one-step Bellman inequalities to the
law-side Borel verification theorem.

For the concrete uniform moving-average shock, this file proves that:

* every feasible time-dependent Borel Sender deviation has expected discounted
  payoff no greater than the Sender equilibrium value; and
* every feasible time-dependent Borel Target deviation, after substituting the
  realized greatest Sender best response, has expected discounted payoff no
  greater than the Target equilibrium value.

The Target theorem obtains measurability of the realized Sender response from
the same carrier-continuity input already consumed by the coupled construction.
It does not add a selector-regularity assumption or a new model field.
-/

import Sanctions.Foundations.BorelBoxLawVerification
import Sanctions.Theory.Bellman.InvariantBall
import Sanctions.Theory.Shocked.CoupledPerovExistence
import Sanctions.Theory.Shocked.MovingAverageShock
import Sanctions.Theory.Shocked.ShockedOneStepVerification

open MeasureTheory BoundedContinuousFunction

namespace Sanctions
namespace AbstractGame

noncomputable section

/-! ## Sender Borel deviations -/

/-- The feasible next-state drift generated by a time-dependent Sender
deviation. -/
noncomputable def movAvgSenderDeviationDrift
    (p : Params) (s : ℕ → BoxState → ℝ)
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I) :
    ℕ → BoxState → BoxState :=
  fun n x => ⟨p.F x.val (s n x), p.F_mem x.val (s n x) x.property (hs_mem n x)⟩

/-- A Borel Sender deviation induces a Borel next-state drift. -/
theorem movAvgSenderDeviationDrift_measurable
    (p : Params) (s : ℕ → BoxState → ℝ)
    (hs_meas : ∀ n, Measurable (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I) :
    ∀ n, Measurable (movAvgSenderDeviationDrift p s hs_mem n) := by
  intro n
  apply Measurable.subtype_mk
  exact p.F_continuous.measurable.comp
    (measurable_subtype_coe.prodMk (hs_meas n))

/-- Sender stage payoff along a time-dependent deviation while the Target keeps
its equilibrium feedback policy. -/
noncomputable def movAvgSenderDeviationStage
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ℕ → BoxState → ℝ) :
    ℕ → BoxState → ℝ :=
  fun n x => p.U_S x.val (E.α x.val) (s n x)

/-- Sender deviation stage payoffs are Borel measurable. -/
theorem movAvgSenderDeviationStage_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ℕ → BoxState → ℝ) (hs_meas : ∀ n, Measurable (s n)) :
    ∀ n, Measurable (movAvgSenderDeviationStage p hh E s n) := by
  intro n
  exact p.U_S_continuous.measurable.comp
    (measurable_subtype_coe.prodMk
      ((E.hα.measurable.comp measurable_subtype_coe).prodMk (hs_meas n)))

/-- Expected discounted Sender payoff under a feasible time-dependent Borel
feedback deviation. -/
noncomputable def movAvgSenderBorelDeviationPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ℕ → BoxState → ℝ)
    (hs_meas : ∀ n, Measurable (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I)
    (μ₀ : BorelBoxProbabilityLaw) : ℝ :=
  borelBoxExpectedDiscountedPayoff
    (movAvgSenderDeviationDrift p s hs_mem)
    (movAvgSenderDeviationDrift_measurable p s hs_meas hs_mem)
    h hh (movAvgSenderDeviationStage p hh E s) p.β_S μ₀

/-- **Sender lifetime verification against arbitrary Borel feedback
deviations.**  The one-step shocked Sender Bellman inequality integrates and
telescopes along the deviation-induced probability laws. -/
theorem movAvgSenderBorelDeviationPayoff_le_value
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (s : ℕ → BoxState → ℝ)
    (hs_meas : ∀ n, Measurable (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgSenderBorelDeviationPayoff p hh E s hs_meas hs_mem μ₀ ≤
      borelBoxLawValue E.V_S μ₀ := by
  obtain ⟨M_S, -, hM_S⟩ := p.cube_bound_U_S
  apply borelBoxExpectedDiscountedPayoff_le_value
    (g := movAvgSenderDeviationDrift p s hs_mem)
    (hg := movAvgSenderDeviationDrift_measurable p s hs_meas hs_mem)
    h hh
    (u := movAvgSenderDeviationStage p hh E s)
    (hu := movAvgSenderDeviationStage_measurable p hh E s hs_meas)
    p.β_S p.β_S_mem.1 p.β_S_mem.2 E.V_S
    (M_u := M_S)
  · intro n x
    have hF : p.F x.val (s n x) ∈ Sanctions.S :=
      p.F_mem x.val (s n x) x.property (hs_mem n x)
    have hclip :
        Sanctions.clipS' (p.F x.val (s n x)) =
          movAvgSenderDeviationDrift p s hs_mem n x := by
      apply Subtype.ext
      exact Sanctions.clipS'_val_eq_of_mem hF
    have hstep := (movAvgShockedParams p hh).sender_shocked_bellman_le
      E x.property (hs_mem n x)
    change p.U_S x.val (E.α x.val) (s n x) +
      p.β_S * (Sanctions.movAvgBCF hh E.V_S)
        (Sanctions.clipS' (p.F x.val (s n x))) ≤ E.V_S x at hstep
    rw [hclip] at hstep
    simpa [movAvgSenderDeviationStage] using hstep
  · intro n x
    exact hM_S x.val x.property (E.α x.val) (E.α_mem x.val x.property)
      (s n x) (hs_mem n x)

/-! ## Target Borel deviations with the realized Sender best response -/

/-- The greatest forward-looking Sender best response realized after a Target
deviation chooses `a`. -/
noncomputable def movAvgTargetDeviationResponse
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) :
    ℕ → BoxState → ℝ :=
  fun n x => p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) x.val (a n x)

theorem movAvgTargetDeviationResponse_mem
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) (n : ℕ) (x : BoxState) :
    movAvgTargetDeviationResponse p hh E a n x ∈ Sanctions.I :=
  p.σ_dyn_top_mem_I (Sanctions.movAvgBCF hh E.V_S) x.val (a n x)

/-- Joint Borel measurability of the Sender selector makes the realized
response to every Borel Target deviation Borel measurable. -/
theorem movAvgTargetDeviationResponse_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) (ha_meas : ∀ n, Measurable (a n))
    (hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2)) :
    ∀ n, Measurable (movAvgTargetDeviationResponse p hh E a n) := by
  intro n
  exact hσ_meas.comp (measurable_id.prodMk (ha_meas n))

/-- Target-deviation next-state drift after substituting the realized greatest
Sender best response. -/
noncomputable def movAvgTargetDeviationDrift
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) :
    ℕ → BoxState → BoxState :=
  fun n x => ⟨p.F x.val (movAvgTargetDeviationResponse p hh E a n x),
    p.F_mem x.val (movAvgTargetDeviationResponse p hh E a n x) x.property
      (movAvgTargetDeviationResponse_mem p hh E a n x)⟩

theorem movAvgTargetDeviationDrift_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) (ha_meas : ∀ n, Measurable (a n))
    (hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2)) :
    ∀ n, Measurable (movAvgTargetDeviationDrift p hh E a n) := by
  intro n
  apply Measurable.subtype_mk
  exact p.F_continuous.measurable.comp
    (measurable_subtype_coe.prodMk
      (movAvgTargetDeviationResponse_measurable p hh E a ha_meas hσ_meas n))

/-- Target stage payoff along a Borel deviation after the realized Sender best
response is substituted. -/
noncomputable def movAvgTargetDeviationStage
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) :
    ℕ → BoxState → ℝ :=
  fun n x => p.U_T x.val (a n x) (movAvgTargetDeviationResponse p hh E a n x)

theorem movAvgTargetDeviationStage_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    (a : ℕ → BoxState → ℝ) (ha_meas : ∀ n, Measurable (a n))
    (hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2)) :
    ∀ n, Measurable (movAvgTargetDeviationStage p hh E a n) := by
  intro n
  exact p.U_T_continuous.measurable.comp
    (measurable_subtype_coe.prodMk
      ((ha_meas n).prodMk
        (movAvgTargetDeviationResponse_measurable p hh E a ha_meas hσ_meas n)))

/-- Expected discounted Target payoff under a feasible time-dependent Borel
feedback deviation, with the realized greatest Sender best response
substituted period by period.  Selector measurability is recovered from the
existing coupled-carrier construction input. -/
noncomputable def movAvgTargetBorelDeviationPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (a : ℕ → BoxState → ℝ) (ha_meas : ∀ n, Measurable (a n))
    (μ₀ : BorelBoxProbabilityLaw) : ℝ := by
  have hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2) :=
    (movAvgShockedParams p hh).coupledShocked_senderSelector_measurable_of_mem
      hσc E hVS
  exact borelBoxExpectedDiscountedPayoff
    (movAvgTargetDeviationDrift p hh E a)
    (movAvgTargetDeviationDrift_measurable p hh E a ha_meas hσ_meas)
    h hh (movAvgTargetDeviationStage p hh E a) p.β_T μ₀

/-- **Target lifetime verification against arbitrary Borel feedback
deviations.**  After substituting the realized Sender best response, the
one-step Target Bellman inequality integrates and telescopes along the
deviation-induced probability laws. -/
theorem movAvgTargetBorelDeviationPayoff_le_value
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (a : ℕ → BoxState → ℝ)
    (ha_meas : ∀ n, Measurable (a n))
    (ha_mem : ∀ n x, a n x ∈ Sanctions.I)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgTargetBorelDeviationPayoff p hh E hσc hVS a ha_meas μ₀ ≤
      borelBoxLawValue E.V_T μ₀ := by
  have hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2) :=
    (movAvgShockedParams p hh).coupledShocked_senderSelector_measurable_of_mem
      hσc E hVS
  obtain ⟨M_T, -, hM_T⟩ := p.cube_bound_U_T
  apply borelBoxExpectedDiscountedPayoff_le_value
    (g := movAvgTargetDeviationDrift p hh E a)
    (hg := movAvgTargetDeviationDrift_measurable p hh E a ha_meas hσ_meas)
    h hh
    (u := movAvgTargetDeviationStage p hh E a)
    (hu := movAvgTargetDeviationStage_measurable p hh E a ha_meas hσ_meas)
    p.β_T p.β_T_mem.1 p.β_T_mem.2 E.V_T
    (M_u := M_T)
  · intro n x
    let s := movAvgTargetDeviationResponse p hh E a n x
    have hs : s ∈ Sanctions.I :=
      movAvgTargetDeviationResponse_mem p hh E a n x
    have hF : p.F x.val s ∈ Sanctions.S :=
      p.F_mem x.val s x.property hs
    have hclip :
        Sanctions.clipS' (p.F x.val s) =
          movAvgTargetDeviationDrift p hh E a n x := by
      apply Subtype.ext
      exact Sanctions.clipS'_val_eq_of_mem hF
    have hstep := (movAvgShockedParams p hh).target_shocked_bellman_le
      E x.property (ha_mem n x)
    change p.U_T x.val (a n x) s +
      p.β_T * (Sanctions.movAvgBCF hh E.V_T)
        (Sanctions.clipS' (p.F x.val s)) ≤ E.V_T x at hstep
    rw [hclip] at hstep
    simpa [movAvgTargetDeviationStage] using hstep
  · intro n x
    exact hM_T x.val x.property (a n x) (ha_mem n x)
      (movAvgTargetDeviationResponse p hh E a n x)
      (movAvgTargetDeviationResponse_mem p hh E a n x)

/-! ## Attained equilibrium paths -/

/-- The stationary equilibrium Target action, written as a time-dependent
sequence so it can be passed to the Borel law telescope. -/
noncomputable def movAvgEquilibriumTargetAction
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ℕ → BoxState → ℝ :=
  fun _ x => E.α x.val

theorem movAvgEquilibriumTargetAction_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ∀ n, Measurable (movAvgEquilibriumTargetAction p hh E n) := by
  intro n
  exact E.hα.measurable.comp measurable_subtype_coe

theorem movAvgEquilibriumTargetAction_mem
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ∀ n x, movAvgEquilibriumTargetAction p hh E n x ∈ Sanctions.I := by
  intro n x
  exact E.α_mem x.val x.property

/-- The stationary realized greatest Sender response to the equilibrium Target
policy, again written as a time-dependent sequence. -/
noncomputable def movAvgEquilibriumSenderAction
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ℕ → BoxState → ℝ :=
  fun _ x =>
    p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) x.val (E.α x.val)

theorem movAvgEquilibriumSenderAction_mem
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop) :
    ∀ n x, movAvgEquilibriumSenderAction p hh E n x ∈ Sanctions.I := by
  intro n x
  exact p.σ_dyn_top_mem_I (Sanctions.movAvgBCF hh E.V_S) x.val (E.α x.val)

/-- The existing coupled-carrier selector continuity makes the realized
equilibrium Sender action Borel measurable. -/
theorem movAvgEquilibriumSenderAction_measurable
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS) :
    ∀ n, Measurable (movAvgEquilibriumSenderAction p hh E n) := by
  have hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2) :=
    (movAvgShockedParams p hh).coupledShocked_senderSelector_measurable_of_mem
      hσc E hVS
  intro n
  exact hσ_meas.comp
    (measurable_id.prodMk (E.hα.measurable.comp measurable_subtype_coe))

/-- Expected discounted Sender payoff on the attained equilibrium path. -/
noncomputable def movAvgSenderEquilibriumPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (μ₀ : BorelBoxProbabilityLaw) : ℝ :=
  movAvgSenderBorelDeviationPayoff p hh E
    (movAvgEquilibriumSenderAction p hh E)
    (movAvgEquilibriumSenderAction_measurable p hh E hσc hVS)
    (movAvgEquilibriumSenderAction_mem p hh E) μ₀

/-- The attained equilibrium Sender path realizes the Sender value exactly. -/
theorem movAvgSenderEquilibriumPayoff_eq_value
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgSenderEquilibriumPayoff p hh E hσc hVS μ₀ =
      borelBoxLawValue E.V_S μ₀ := by
  obtain ⟨M_S, -, hM_S⟩ := p.cube_bound_U_S
  unfold movAvgSenderEquilibriumPayoff movAvgSenderBorelDeviationPayoff
  apply borelBoxExpectedDiscountedPayoff_eq_value
    (g := movAvgSenderDeviationDrift p
      (movAvgEquilibriumSenderAction p hh E)
      (movAvgEquilibriumSenderAction_mem p hh E))
    (hg := movAvgSenderDeviationDrift_measurable p
      (movAvgEquilibriumSenderAction p hh E)
      (movAvgEquilibriumSenderAction_measurable p hh E hσc hVS)
      (movAvgEquilibriumSenderAction_mem p hh E))
    h hh
    (u := movAvgSenderDeviationStage p hh E
      (movAvgEquilibriumSenderAction p hh E))
    (hu := movAvgSenderDeviationStage_measurable p hh E
      (movAvgEquilibriumSenderAction p hh E)
      (movAvgEquilibriumSenderAction_measurable p hh E hσc hVS))
    p.β_S p.β_S_mem.1 p.β_S_mem.2 E.V_S
    (M_u := M_S)
  · intro n x
    let s := movAvgEquilibriumSenderAction p hh E n x
    have hs : s ∈ Sanctions.I :=
      movAvgEquilibriumSenderAction_mem p hh E n x
    have hF : p.F x.val s ∈ Sanctions.S :=
      p.F_mem x.val s x.property hs
    have hclip :
        Sanctions.clipS' (p.F x.val s) =
          movAvgSenderDeviationDrift p
            (movAvgEquilibriumSenderAction p hh E)
            (movAvgEquilibriumSenderAction_mem p hh E) n x := by
      apply Subtype.ext
      exact Sanctions.clipS'_val_eq_of_mem hF
    have hstep :=
      (movAvgShockedParams p hh).sender_shocked_bellman_eq_at_top_response
        E x.property
    change E.V_S x =
      p.U_S x.val (E.α x.val) s +
        p.β_S * (Sanctions.movAvgBCF hh E.V_S)
          (Sanctions.clipS' (p.F x.val s)) at hstep
    rw [hclip] at hstep
    simpa [movAvgSenderDeviationStage] using hstep.symm
  · intro n x
    exact hM_S x.val x.property (E.α x.val) (E.α_mem x.val x.property)
      (movAvgEquilibriumSenderAction p hh E n x)
      (movAvgEquilibriumSenderAction_mem p hh E n x)

/-- Expected discounted Target payoff on the attained equilibrium path. -/
noncomputable def movAvgTargetEquilibriumPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (μ₀ : BorelBoxProbabilityLaw) : ℝ :=
  movAvgTargetBorelDeviationPayoff p hh E hσc hVS
    (movAvgEquilibriumTargetAction p hh E)
    (movAvgEquilibriumTargetAction_measurable p hh E) μ₀

/-- The attained equilibrium Target path realizes the Target value exactly. -/
theorem movAvgTargetEquilibriumPayoff_eq_value
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgTargetEquilibriumPayoff p hh E hσc hVS μ₀ =
      borelBoxLawValue E.V_T μ₀ := by
  have hσ_meas : Measurable (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh E.V_S) xa.1.val xa.2) :=
    (movAvgShockedParams p hh).coupledShocked_senderSelector_measurable_of_mem
      hσc E hVS
  obtain ⟨M_T, -, hM_T⟩ := p.cube_bound_U_T
  unfold movAvgTargetEquilibriumPayoff movAvgTargetBorelDeviationPayoff
  apply borelBoxExpectedDiscountedPayoff_eq_value
    (g := movAvgTargetDeviationDrift p hh E
      (movAvgEquilibriumTargetAction p hh E))
    (hg := movAvgTargetDeviationDrift_measurable p hh E
      (movAvgEquilibriumTargetAction p hh E)
      (movAvgEquilibriumTargetAction_measurable p hh E) hσ_meas)
    h hh
    (u := movAvgTargetDeviationStage p hh E
      (movAvgEquilibriumTargetAction p hh E))
    (hu := movAvgTargetDeviationStage_measurable p hh E
      (movAvgEquilibriumTargetAction p hh E)
      (movAvgEquilibriumTargetAction_measurable p hh E) hσ_meas)
    p.β_T p.β_T_mem.1 p.β_T_mem.2 E.V_T
    (M_u := M_T)
  · intro n x
    let a := movAvgEquilibriumTargetAction p hh E n x
    let s := movAvgTargetDeviationResponse p hh E
      (movAvgEquilibriumTargetAction p hh E) n x
    have hs : s ∈ Sanctions.I :=
      movAvgTargetDeviationResponse_mem p hh E
        (movAvgEquilibriumTargetAction p hh E) n x
    have hF : p.F x.val s ∈ Sanctions.S :=
      p.F_mem x.val s x.property hs
    have hclip :
        Sanctions.clipS' (p.F x.val s) =
          movAvgTargetDeviationDrift p hh E
            (movAvgEquilibriumTargetAction p hh E) n x := by
      apply Subtype.ext
      exact Sanctions.clipS'_val_eq_of_mem hF
    have hstep :=
      (movAvgShockedParams p hh).target_shocked_bellman_eq_at_policy
        E x.property
    change E.V_T x =
      p.U_T x.val a s +
        p.β_T * (Sanctions.movAvgBCF hh E.V_T)
          (Sanctions.clipS' (p.F x.val s)) at hstep
    rw [hclip] at hstep
    simpa [movAvgTargetDeviationStage] using hstep.symm
  · intro n x
    exact hM_T x.val x.property
      (movAvgEquilibriumTargetAction p hh E n x)
      (movAvgEquilibriumTargetAction_mem p hh E n x)
      (movAvgTargetDeviationResponse p hh E
        (movAvgEquilibriumTargetAction p hh E) n x)
      (movAvgTargetDeviationResponse_mem p hh E
        (movAvgEquilibriumTargetAction p hh E) n x)

/-- Every feasible time-dependent Borel Sender deviation is weakly worse than
the attained equilibrium Sender path. -/
theorem movAvgSenderBorelDeviationPayoff_le_equilibriumPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (s : ℕ → BoxState → ℝ)
    (hs_meas : ∀ n, Measurable (s n))
    (hs_mem : ∀ n x, s n x ∈ Sanctions.I)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgSenderBorelDeviationPayoff p hh E s hs_meas hs_mem μ₀ ≤
      movAvgSenderEquilibriumPayoff p hh E hσc hVS μ₀ := by
  calc
    movAvgSenderBorelDeviationPayoff p hh E s hs_meas hs_mem μ₀ ≤
        borelBoxLawValue E.V_S μ₀ :=
      movAvgSenderBorelDeviationPayoff_le_value p hh E s hs_meas hs_mem μ₀
    _ = movAvgSenderEquilibriumPayoff p hh E hσc hVS μ₀ :=
      (movAvgSenderEquilibriumPayoff_eq_value p hh E hσc hVS μ₀).symm

/-- Every feasible time-dependent Borel Target deviation, after substituting
the realized greatest Sender best response, is weakly worse than the attained
equilibrium Target path. -/
theorem movAvgTargetBorelDeviationPayoff_le_equilibriumPayoff
    (p : Params) {h : ℝ} (hh : 0 < h)
    (E : (movAvgShockedParams p hh).ShockedFeedbackStackelbergEquilibriumTop)
    {carrierS : Set SBCF}
    (hσc : ∀ V_S : ↥carrierS, Continuous (fun xa : BoxState × ℝ =>
      p.σ_dyn_top (Sanctions.movAvgBCF hh V_S.val) xa.1.val xa.2))
    (hVS : E.V_S ∈ carrierS)
    (a : ℕ → BoxState → ℝ)
    (ha_meas : ∀ n, Measurable (a n))
    (ha_mem : ∀ n x, a n x ∈ Sanctions.I)
    (μ₀ : BorelBoxProbabilityLaw) :
    movAvgTargetBorelDeviationPayoff p hh E hσc hVS a ha_meas μ₀ ≤
      movAvgTargetEquilibriumPayoff p hh E hσc hVS μ₀ := by
  calc
    movAvgTargetBorelDeviationPayoff p hh E hσc hVS a ha_meas μ₀ ≤
        borelBoxLawValue E.V_T μ₀ :=
      movAvgTargetBorelDeviationPayoff_le_value p hh E hσc hVS
        a ha_meas ha_mem μ₀
    _ = movAvgTargetEquilibriumPayoff p hh E hσc hVS μ₀ :=
      (movAvgTargetEquilibriumPayoff_eq_value p hh E hσc hVS μ₀).symm

end

