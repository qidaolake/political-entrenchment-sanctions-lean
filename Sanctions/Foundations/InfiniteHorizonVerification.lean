/-
Sanctions/Foundations/InfiniteHorizonVerification.lean

Generic deterministic infinite-horizon Bellman verification.

The one-step Bellman inequality implies a finite-horizon telescoping bound for
every time-dependent Markov deviation.  When the discounted stage-payoff series
is summable and the discounted terminal value vanishes, the finite bound passes
to the infinite sum.  A policy that attains the Bellman equation on its path
achieves the candidate value exactly.

The summability and terminal-value conditions are stated explicitly.  The final
section gives reusable dischargers from uniform payoff and value bounds when
the discount factor lies in `[0, 1)`.
-/

import Sanctions.Foundations.MultistageGames
import Mathlib.Analysis.Normed.Group.InfiniteSum
import Mathlib.Analysis.SpecificLimits.Normed
import Mathlib.Topology.Algebra.InfiniteSum.NatInt

noncomputable section

open Filter Finset
open scoped Topology

namespace Sanctions
namespace InfiniteHorizonVerification

/-- A time-dependent Markov plan chooses an action from the current state in every period. -/
abbrev MarkovPlan (X A : Type*) := ℕ → X → A

/-- The deterministic state path induced by a time-dependent Markov plan. -/
def statePath {X A : Type*} (F : X → A → X) (π : MarkovPlan X A) (x₀ : X) :
    ℕ → X
  | 0 => x₀
  | n + 1 =>
      let x := statePath F π x₀ n
      F x (π n x)

/-- Regard a stationary feedback policy as a time-dependent Markov plan. -/
def stationaryPlan {X A : Type*} (α : X → A) : MarkovPlan X A := fun _ => α

/-- The period-`n` discounted payoff generated by a Markov plan. -/
def discountedStage {X A : Type*} (u : X → A → ℝ) (F : X → A → X) (β : ℝ)
    (π : MarkovPlan X A) (x₀ : X) (n : ℕ) : ℝ :=
  β ^ n * u (statePath F π x₀ n) (π n (statePath F π x₀ n))

/-- The first `N` discounted stage payoffs generated by a Markov plan. -/
def finitePayoff {X A : Type*} (u : X → A → ℝ) (F : X → A → X) (β : ℝ)
    (π : MarkovPlan X A) (x₀ : X) (N : ℕ) : ℝ :=
  ∑ n ∈ range N, discountedStage u F β π x₀ n

/-- The infinite discounted payoff, defined as the `tsum` of discounted stages. -/
def discountedPayoff {X A : Type*} (u : X → A → ℝ) (F : X → A → X) (β : ℝ)
    (π : MarkovPlan X A) (x₀ : X) : ℝ :=
  ∑' n : ℕ, discountedStage u F β π x₀ n

/-- The discounted continuation value left after the first `N` periods. -/
def terminalValue {X A : Type*} (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (π : MarkovPlan X A) (x₀ : X) (N : ℕ) : ℝ :=
  β ^ N * V (statePath F π x₀ N)

@[simp] theorem statePath_zero {X A : Type*} (F : X → A → X)
    (π : MarkovPlan X A) (x₀ : X) :
    statePath F π x₀ 0 = x₀ :=
  rfl

@[simp] theorem statePath_succ {X A : Type*} (F : X → A → X)
    (π : MarkovPlan X A) (x₀ : X) (n : ℕ) :
    statePath F π x₀ (n + 1) =
      F (statePath F π x₀ n) (π n (statePath F π x₀ n)) :=
  rfl

/-! ## Finite-horizon telescoping -/

/-- A Bellman supersolution gives the discounted one-period telescoping inequality. -/
theorem discounted_bellman_step_le
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (π : MarkovPlan X A) (x₀ : X) (n : ℕ) :
    discountedStage u F β π x₀ n + terminalValue F β V π x₀ (n + 1) ≤
      terminalValue F β V π x₀ n := by
  let x := statePath F π x₀ n
  let a := π n x
  have h := mul_le_mul_of_nonneg_left (h_bellman x a) (pow_nonneg hβ n)
  simpa [discountedStage, terminalValue, x, a, pow_succ, mul_add, mul_assoc] using h

/-- Finite payoff plus discounted terminal value never exceeds a Bellman supersolution. -/
theorem finitePayoff_add_terminal_le_value
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (π : MarkovPlan X A) (x₀ : X) :
    ∀ N : ℕ, finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N ≤ V x₀ := by
  intro N
  induction N with
  | zero =>
      simp [finitePayoff, terminalValue]
  | succ N ih =>
      calc
        finitePayoff u F β π x₀ (N + 1) + terminalValue F β V π x₀ (N + 1) =
            finitePayoff u F β π x₀ N +
              (discountedStage u F β π x₀ N + terminalValue F β V π x₀ (N + 1)) := by
                simp only [finitePayoff, sum_range_succ]
                ring
        _ ≤ finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N :=
          by
            have hstep :=
              discounted_bellman_step_le u F β V hβ h_bellman π x₀ N
            linarith
        _ ≤ V x₀ := ih

/-- Bellman equality along a plan gives the exact discounted telescoping identity. -/
theorem finitePayoff_add_terminal_eq_value
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (π : MarkovPlan X A) (x₀ : X)
    (h_attains : ∀ n : ℕ,
      u (statePath F π x₀ n) (π n (statePath F π x₀ n)) +
          β * V (statePath F π x₀ (n + 1)) =
        V (statePath F π x₀ n)) :
    ∀ N : ℕ, finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N = V x₀ := by
  intro N
  induction N with
  | zero =>
      simp [finitePayoff, terminalValue]
  | succ N ih =>
      have hstep :
          discountedStage u F β π x₀ N + terminalValue F β V π x₀ (N + 1) =
            terminalValue F β V π x₀ N := by
        have h := congrArg (fun z : ℝ => β ^ N * z) (h_attains N)
        simpa [discountedStage, terminalValue, pow_succ, mul_add, mul_assoc] using h
      calc
        finitePayoff u F β π x₀ (N + 1) + terminalValue F β V π x₀ (N + 1) =
            finitePayoff u F β π x₀ N +
              (discountedStage u F β π x₀ N + terminalValue F β V π x₀ (N + 1)) := by
                simp only [finitePayoff, sum_range_succ]
                ring
        _ = finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N := by rw [hstep]
        _ = V x₀ := ih

/-! ## Infinite-horizon verification -/

/-- A Bellman supersolution bounds the `tsum` payoff of every admissible Markov plan. -/
theorem discountedPayoff_le_value
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (π : MarkovPlan X A) (x₀ : X)
    (h_summable : Summable (discountedStage u F β π x₀))
    (h_terminal :
      Tendsto (terminalValue F β V π x₀) atTop (𝓝 0)) :
    discountedPayoff u F β π x₀ ≤ V x₀ := by
  have h_partial :
      Tendsto (finitePayoff u F β π x₀) atTop
        (𝓝 (discountedPayoff u F β π x₀)) := by
    simpa [finitePayoff, discountedPayoff] using h_summable.tendsto_sum_tsum_nat
  have h_total :
      Tendsto
        (fun N => finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N)
        atTop (𝓝 (discountedPayoff u F β π x₀)) := by
    simpa using h_partial.add h_terminal
  exact le_of_tendsto' h_total
    (finitePayoff_add_terminal_le_value u F β V hβ h_bellman π x₀)

/-- A plan attaining Bellman equality on its path has `tsum` payoff exactly equal to `V`. -/
theorem discountedPayoff_eq_value
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (π : MarkovPlan X A) (x₀ : X)
    (h_attains : ∀ n : ℕ,
      u (statePath F π x₀ n) (π n (statePath F π x₀ n)) +
          β * V (statePath F π x₀ (n + 1)) =
        V (statePath F π x₀ n))
    (h_summable : Summable (discountedStage u F β π x₀))
    (h_terminal :
      Tendsto (terminalValue F β V π x₀) atTop (𝓝 0)) :
    discountedPayoff u F β π x₀ = V x₀ := by
  have h_partial :
      Tendsto (finitePayoff u F β π x₀) atTop
        (𝓝 (discountedPayoff u F β π x₀)) := by
    simpa [finitePayoff, discountedPayoff] using h_summable.tendsto_sum_tsum_nat
  have h_total :
      Tendsto
        (fun N => finitePayoff u F β π x₀ N + terminalValue F β V π x₀ N)
        atTop (𝓝 (discountedPayoff u F β π x₀)) := by
    simpa using h_partial.add h_terminal
  apply le_antisymm
  · exact le_of_tendsto' h_total fun N =>
      le_of_eq (finitePayoff_add_terminal_eq_value u F β V π x₀ h_attains N)
  · exact ge_of_tendsto' h_total fun N =>
      le_of_eq (finitePayoff_add_terminal_eq_value u F β V π x₀ h_attains N).symm

/-- A stationary Bellman maximizer is optimal against every time-dependent Markov deviation. -/
theorem stationary_optimal_against_markov_deviation
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ) (α : X → A)
    (hβ : 0 ≤ β)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (h_attains : ∀ x : X, u x (α x) + β * V (F x (α x)) = V x)
    (π : MarkovPlan X A) (x₀ : X)
    (h_summable_π : Summable (discountedStage u F β π x₀))
    (h_terminal_π : Tendsto (terminalValue F β V π x₀) atTop (𝓝 0))
    (h_summable_α : Summable (discountedStage u F β (stationaryPlan α) x₀))
    (h_terminal_α :
      Tendsto (terminalValue F β V (stationaryPlan α) x₀) atTop (𝓝 0)) :
    discountedPayoff u F β π x₀ ≤
      discountedPayoff u F β (stationaryPlan α) x₀ := by
  have h_dev :=
    discountedPayoff_le_value u F β V hβ h_bellman π x₀ h_summable_π h_terminal_π
  have h_eq :
      discountedPayoff u F β (stationaryPlan α) x₀ = V x₀ := by
    apply discountedPayoff_eq_value u F β V (stationaryPlan α) x₀
    · intro n
      simpa [stationaryPlan] using h_attains (statePath F (stationaryPlan α) x₀ n)
    · exact h_summable_α
    · exact h_terminal_α
  simpa [h_eq] using h_dev

/-! ## Uniform-bound dischargers

These lemmas do not add regularity to a game model.  They show how explicit
uniform bounds, once derived from a compact carrier or other primitives, imply
the analytic side conditions used by the `tsum` verification theorems above. -/

/-- Uniformly bounded stage payoffs give a summable discounted payoff series. -/
theorem discountedStage_summable_of_uniform_bound
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ)
    (hβ : 0 ≤ β) (hβ_lt : β < 1)
    (π : MarkovPlan X A) (x₀ : X) (M : ℝ)
    (h_bound : ∀ n : ℕ,
      |u (statePath F π x₀ n) (π n (statePath F π x₀ n))| ≤ M) :
    Summable (discountedStage u F β π x₀) := by
  have h_geom : Summable (fun n : ℕ => β ^ n) :=
    summable_geometric_of_lt_one hβ hβ_lt
  have h_majorant : Summable (fun n : ℕ => β ^ n * M) := h_geom.mul_right M
  apply Summable.of_norm_bounded h_majorant
  intro n
  rw [discountedStage, Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg hβ]
  exact mul_le_mul_of_nonneg_left (h_bound n) (pow_nonneg hβ n)

/-- A uniformly bounded value path has vanishing discounted terminal value. -/
theorem terminalValue_tendsto_zero_of_uniform_bound
    {X A : Type*}
    (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β) (hβ_lt : β < 1)
    (π : MarkovPlan X A) (x₀ : X) (M : ℝ)
    (h_bound : ∀ n : ℕ, |V (statePath F π x₀ n)| ≤ M) :
    Tendsto (terminalValue F β V π x₀) atTop (𝓝 0) := by
  apply squeeze_zero_norm (a := fun n : ℕ => β ^ n * M)
  · intro n
    rw [terminalValue, Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg hβ]
    exact mul_le_mul_of_nonneg_left (h_bound n) (pow_nonneg hβ n)
  · simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hβ hβ_lt).mul_const M

/-- Uniform payoff and value bounds discharge the infinite-horizon deviation conditions. -/
theorem discountedPayoff_le_value_of_uniform_bounds
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β) (hβ_lt : β < 1)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (π : MarkovPlan X A) (x₀ : X) (M_u M_V : ℝ)
    (h_u_bound : ∀ n : ℕ,
      |u (statePath F π x₀ n) (π n (statePath F π x₀ n))| ≤ M_u)
    (h_V_bound : ∀ n : ℕ, |V (statePath F π x₀ n)| ≤ M_V) :
    discountedPayoff u F β π x₀ ≤ V x₀ :=
  discountedPayoff_le_value u F β V hβ h_bellman π x₀
    (discountedStage_summable_of_uniform_bound u F β hβ hβ_lt π x₀ M_u h_u_bound)
    (terminalValue_tendsto_zero_of_uniform_bound F β V hβ hβ_lt π x₀ M_V h_V_bound)

/-- Uniform bounds turn pathwise Bellman attainment into exact infinite-horizon value. -/
theorem discountedPayoff_eq_value_of_uniform_bounds
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ)
    (hβ : 0 ≤ β) (hβ_lt : β < 1)
    (π : MarkovPlan X A) (x₀ : X)
    (h_attains : ∀ n : ℕ,
      u (statePath F π x₀ n) (π n (statePath F π x₀ n)) +
          β * V (statePath F π x₀ (n + 1)) =
        V (statePath F π x₀ n))
    (M_u M_V : ℝ)
    (h_u_bound : ∀ n : ℕ,
      |u (statePath F π x₀ n) (π n (statePath F π x₀ n))| ≤ M_u)
    (h_V_bound : ∀ n : ℕ, |V (statePath F π x₀ n)| ≤ M_V) :
    discountedPayoff u F β π x₀ = V x₀ :=
  discountedPayoff_eq_value u F β V π x₀ h_attains
    (discountedStage_summable_of_uniform_bound u F β hβ hβ_lt π x₀ M_u h_u_bound)
    (terminalValue_tendsto_zero_of_uniform_bound F β V hβ hβ_lt π x₀ M_V h_V_bound)

/-- Global payoff and value bounds make a stationary Bellman maximizer optimal against every
time-dependent Markov deviation without separate pathwise analytic hypotheses. -/
theorem stationary_optimal_against_markov_deviation_of_global_bounds
    {X A : Type*}
    (u : X → A → ℝ) (F : X → A → X) (β : ℝ) (V : X → ℝ) (α : X → A)
    (hβ : 0 ≤ β) (hβ_lt : β < 1)
    (h_bellman : ∀ x : X, ∀ a : A, u x a + β * V (F x a) ≤ V x)
    (h_attains : ∀ x : X, u x (α x) + β * V (F x (α x)) = V x)
    (M_u M_V : ℝ)
    (h_u_bound : ∀ x : X, ∀ a : A, |u x a| ≤ M_u)
    (h_V_bound : ∀ x : X, |V x| ≤ M_V)
    (π : MarkovPlan X A) (x₀ : X) :
    discountedPayoff u F β π x₀ ≤
      discountedPayoff u F β (stationaryPlan α) x₀ := by
  apply stationary_optimal_against_markov_deviation u F β V α hβ h_bellman h_attains
  · exact discountedStage_summable_of_uniform_bound u F β hβ hβ_lt π x₀ M_u
      fun n => h_u_bound _ _
  · exact terminalValue_tendsto_zero_of_uniform_bound F β V hβ hβ_lt π x₀ M_V
      fun n => h_V_bound _
  · exact discountedStage_summable_of_uniform_bound u F β hβ hβ_lt
      (stationaryPlan α) x₀ M_u fun n => h_u_bound _ _
  · exact terminalValue_tendsto_zero_of_uniform_bound F β V hβ hβ_lt
      (stationaryPlan α) x₀ M_V fun n => h_V_bound _

end InfiniteHorizonVerification

/-! ## Abstract two-player Stackelberg consequences

These wrappers apply the scalar verification theorem twice.  The leader deviates through an
arbitrary time-dependent Markov plan while anticipating the follower response after every
leader action.  The follower deviates through an arbitrary time-dependent Markov plan while
the leader remains at the equilibrium feedback policy. -/

namespace MultistageGames.StackelbergFeedbackEquilibrium

open InfiniteHorizonVerification

/-- The leader's reduced stage payoff after substituting the follower response. -/
def leaderStage
    {X A₁ A₂ : Type*}
    (g₁ : X → A₁ → A₂ → ℝ) (r : X → A₁ → A₂) : X → A₁ → ℝ :=
  fun x a₁ => g₁ x a₁ (r x a₁)

/-- The leader's reduced state transition after substituting the follower response. -/
def leaderTransition
    {X A₁ A₂ : Type*}
    (F : X → A₁ → A₂ → X) (r : X → A₁ → A₂) : X → A₁ → X :=
  fun x a₁ => F x a₁ (r x a₁)

/-- The follower's stage payoff when the leader remains at its equilibrium policy. -/
def followerStage
    {X A₁ A₂ : Type*}
    (g₂ : X → A₁ → A₂ → ℝ) (α₁ : X → A₁) : X → A₂ → ℝ :=
  fun x a₂ => g₂ x (α₁ x) a₂

/-- The follower's transition when the leader remains at its equilibrium policy. -/
def followerTransition
    {X A₁ A₂ : Type*}
    (F : X → A₁ → A₂ → X) (α₁ : X → A₁) : X → A₂ → X :=
  fun x a₂ => F x (α₁ x) a₂

/-- Along the equilibrium policy pair, the leader's infinite discounted payoff equals `W₁`. -/
theorem leader_discountedPayoff_eq_value
    {X A₁ A₂ : Type*}
    {g₁ g₂ : X → A₁ → A₂ → ℝ} {F : X → A₁ → A₂ → X} {β₁ β₂ : ℝ}
    (E : Sanctions.MultistageGames.StackelbergFeedbackEquilibrium g₁ g₂ F β₁ β₂)
    (hβ₁ : 0 ≤ β₁) (hβ₁_lt : β₁ < 1)
    (M_g₁ M_W₁ : ℝ)
    (h_g₁_bound : ∀ x : X, ∀ a₁ : A₁, ∀ a₂ : A₂, |g₁ x a₁ a₂| ≤ M_g₁)
    (h_W₁_bound : ∀ x : X, |E.W₁ x| ≤ M_W₁)
    (x₀ : X) :
    discountedPayoff (leaderStage g₁ E.r) (leaderTransition F E.r) β₁
        (stationaryPlan E.α₁) x₀ =
      E.W₁ x₀ := by
  apply discountedPayoff_eq_value_of_uniform_bounds
    (leaderStage g₁ E.r) (leaderTransition F E.r) β₁ E.W₁ hβ₁ hβ₁_lt
    (stationaryPlan E.α₁) x₀ (M_u := M_g₁) (M_V := M_W₁)
  · intro n
    simpa [leaderStage, leaderTransition, stationaryPlan] using
      (E.hW₁_bellman
        (statePath (leaderTransition F E.r) (stationaryPlan E.α₁) x₀ n)).symm
  · intro n
    exact h_g₁_bound _ _ _
  · intro n
    exact h_W₁_bound _

/-- Along the equilibrium policy pair, the follower's infinite discounted payoff equals `W₂`. -/
theorem follower_discountedPayoff_eq_value
    {X A₁ A₂ : Type*}
    {g₁ g₂ : X → A₁ → A₂ → ℝ} {F : X → A₁ → A₂ → X} {β₁ β₂ : ℝ}
    (E : Sanctions.MultistageGames.StackelbergFeedbackEquilibrium g₁ g₂ F β₁ β₂)
    (hβ₂ : 0 ≤ β₂) (hβ₂_lt : β₂ < 1)
    (M_g₂ M_W₂ : ℝ)
    (h_g₂_bound : ∀ x : X, ∀ a₁ : A₁, ∀ a₂ : A₂, |g₂ x a₁ a₂| ≤ M_g₂)
    (h_W₂_bound : ∀ x : X, |E.W₂ x| ≤ M_W₂)
    (x₀ : X) :
    discountedPayoff (followerStage g₂ E.α₁) (followerTransition F E.α₁) β₂
        (stationaryPlan fun x => E.r x (E.α₁ x)) x₀ =
      E.W₂ x₀ := by
  apply discountedPayoff_eq_value_of_uniform_bounds
    (followerStage g₂ E.α₁) (followerTransition F E.α₁) β₂ E.W₂ hβ₂ hβ₂_lt
    (stationaryPlan fun x => E.r x (E.α₁ x)) x₀ (M_u := M_g₂) (M_V := M_W₂)
  · intro n
    simpa [followerStage, followerTransition, stationaryPlan] using
      (E.hW₂_bellman
        (statePath (followerTransition F E.α₁)
          (stationaryPlan fun x => E.r x (E.α₁ x)) x₀ n)).symm
  · intro n
    exact h_g₂_bound _ _ _
  · intro n
    exact h_W₂_bound _

/-- The equilibrium leader policy beats every time-dependent Markov leader deviation. -/
theorem leader_optimal_against_markov_deviation
    {X A₁ A₂ : Type*}
    {g₁ g₂ : X → A₁ → A₂ → ℝ} {F : X → A₁ → A₂ → X} {β₁ β₂ : ℝ}
    (E : Sanctions.MultistageGames.StackelbergFeedbackEquilibrium g₁ g₂ F β₁ β₂)
    (hβ₁ : 0 ≤ β₁) (hβ₁_lt : β₁ < 1)
    (M_g₁ M_W₁ : ℝ)
    (h_g₁_bound : ∀ x : X, ∀ a₁ : A₁, ∀ a₂ : A₂, |g₁ x a₁ a₂| ≤ M_g₁)
    (h_W₁_bound : ∀ x : X, |E.W₁ x| ≤ M_W₁)
    (π₁ : MarkovPlan X A₁) (x₀ : X) :
    discountedPayoff (leaderStage g₁ E.r) (leaderTransition F E.r) β₁ π₁ x₀ ≤
      discountedPayoff (leaderStage g₁ E.r) (leaderTransition F E.r) β₁
        (stationaryPlan E.α₁) x₀ := by
  apply stationary_optimal_against_markov_deviation_of_global_bounds
    (leaderStage g₁ E.r) (leaderTransition F E.r) β₁ E.W₁ E.α₁
    hβ₁ hβ₁_lt (M_u := M_g₁) (M_V := M_W₁)
  · intro x a₁
    calc
      leaderStage g₁ E.r x a₁ + β₁ * E.W₁ (leaderTransition F E.r x a₁) ≤
          leaderStage g₁ E.r x (E.α₁ x) +
            β₁ * E.W₁ (leaderTransition F E.r x (E.α₁ x)) := by
              simpa [leaderStage, leaderTransition] using E.hα x a₁
      _ = E.W₁ x := by
        simpa [leaderStage, leaderTransition] using (E.hW₁_bellman x).symm
  · intro x
    simpa [leaderStage, leaderTransition] using (E.hW₁_bellman x).symm
  · intro x a₁
    exact h_g₁_bound x a₁ (E.r x a₁)
  · exact h_W₁_bound

/-- The equilibrium follower response beats every time-dependent Markov follower deviation
when the leader remains at its equilibrium feedback policy. -/
theorem follower_optimal_against_markov_deviation
    {X A₁ A₂ : Type*}
    {g₁ g₂ : X → A₁ → A₂ → ℝ} {F : X → A₁ → A₂ → X} {β₁ β₂ : ℝ}
    (E : Sanctions.MultistageGames.StackelbergFeedbackEquilibrium g₁ g₂ F β₁ β₂)
    (hβ₂ : 0 ≤ β₂) (hβ₂_lt : β₂ < 1)
    (M_g₂ M_W₂ : ℝ)
    (h_g₂_bound : ∀ x : X, ∀ a₁ : A₁, ∀ a₂ : A₂, |g₂ x a₁ a₂| ≤ M_g₂)
    (h_W₂_bound : ∀ x : X, |E.W₂ x| ≤ M_W₂)
    (π₂ : MarkovPlan X A₂) (x₀ : X) :
    discountedPayoff (followerStage g₂ E.α₁) (followerTransition F E.α₁) β₂
        π₂ x₀ ≤
      discountedPayoff (followerStage g₂ E.α₁) (followerTransition F E.α₁) β₂
        (stationaryPlan fun x => E.r x (E.α₁ x)) x₀ := by
  apply stationary_optimal_against_markov_deviation_of_global_bounds
    (followerStage g₂ E.α₁) (followerTransition F E.α₁) β₂ E.W₂
    (fun x => E.r x (E.α₁ x)) hβ₂ hβ₂_lt (M_u := M_g₂) (M_V := M_W₂)
  · intro x a₂
    calc
      followerStage g₂ E.α₁ x a₂ + β₂ * E.W₂ (followerTransition F E.α₁ x a₂) ≤
          followerStage g₂ E.α₁ x (E.r x (E.α₁ x)) +
            β₂ * E.W₂ (followerTransition F E.α₁ x (E.r x (E.α₁ x))) := by
              simpa [followerStage, followerTransition] using E.hr x (E.α₁ x) a₂
      _ = E.W₂ x := by
        simpa [followerStage, followerTransition] using (E.hW₂_bellman x).symm
  · intro x
    simpa [followerStage, followerTransition] using (E.hW₂_bellman x).symm
  · intro x a₂
    exact h_g₂_bound x (E.α₁ x) a₂
  · exact h_W₂_bound

end MultistageGames.StackelbergFeedbackEquilibrium
end Sanctions

